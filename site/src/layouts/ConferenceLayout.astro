---
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '');

const nav = [
  { label: 'Overview', href: '/conference' },
  { label: 'Program', href: '/conference/program' },
  { label: 'Abstracts', href: '/conference/abstracts' },
  { label: 'Speakers', href: '/conference/presenters' },
  { label: 'Venue & info', href: '/conference/info' },
];

const isCurrent = (href: string) => {
  const full = url(href).replace(/\/$/, '');
  return full === path || (href !== '/conference' && path.startsWith(full));
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · VUEESC × GESSS 2026</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={url('/espg-logo.svg')} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Montserrat:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />
    <style is:global>
      /* VUEESC × GESSS 2026 · "Ridgeline" identity
       * The conference poster as a website: a Didone wordmark, the poster's
       * teal → lime → gold gradient used sparingly (dates, ridgeline, FREE pill),
       * coral contour lines in the corners, calm navy-on-paper reading column. */
      :root {
        --paper: #f5f6f2;
        --paper-2: #eceee7;
        --card: #ffffff;
        --ink: #14213d;
        --ink-soft: #4a5468;
        --sky: #3d7fb8;
        --teal: #2bb3b1;
        --lime: #a8c94a;
        --gold: #f2c94c;
        --coral: #e8805a;
        --rule: #d5d9cf;
        --grad: linear-gradient(90deg, var(--teal), var(--lime) 55%, var(--gold));

        --font-display: 'Bodoni Moda', 'Didot', 'Bodoni 72', Georgia, serif;
        --font-body: 'Montserrat', system-ui, -apple-system, 'Segoe UI', sans-serif;

        --page-max: 72rem;
        --gutter: clamp(1rem, 4vw, 3rem);
      }

      *,
      *::before,
      *::after { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 16.5px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        position: relative;
      }

      /* Poster-style contour lines in the top corners */
      body::before {
        content: '';
        position: absolute;
        inset: 0 0 auto 0;
        height: 46rem;
        pointer-events: none;
        z-index: 0;
        opacity: 0.55;
        background-image:
          repeating-radial-gradient(ellipse 60% 70% at -6% 8%, transparent 0 22px, rgba(232, 128, 90, 0.35) 22px 23px),
          repeating-radial-gradient(ellipse 50% 60% at 106% 0%, transparent 0 22px, rgba(232, 128, 90, 0.35) 22px 23px);
        -webkit-mask-image: radial-gradient(ellipse 30% 55% at 0% 10%, #000 30%, transparent 75%),
          radial-gradient(ellipse 28% 50% at 100% 0%, #000 30%, transparent 75%);
        mask-image: radial-gradient(ellipse 30% 55% at 0% 10%, #000 30%, transparent 75%),
          radial-gradient(ellipse 28% 50% at 100% 0%, #000 30%, transparent 75%);
      }
      body > * { position: relative; z-index: 1; }

      a { color: var(--sky); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
      a:hover { color: var(--ink); }
      :focus-visible { outline: 2px solid var(--teal); outline-offset: 3px; border-radius: 2px; }

      /* ---- Top bar ---- */
      .topbar {
        max-width: var(--page-max);
        margin: 0 auto;
        padding: 1.1rem var(--gutter);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem 2rem;
        flex-wrap: wrap;
      }
      .topbar .left { display: flex; align-items: baseline; gap: 1.25rem; flex-wrap: wrap; }
      .back {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-soft);
        text-decoration: none;
      }
      .back:hover { color: var(--ink); }
      .mini-mark {
        font-family: var(--font-display);
        font-size: 1.3rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        color: var(--ink);
        text-decoration: none;
        white-space: nowrap;
      }
      .mini-mark:hover { color: var(--ink); }
      .x { color: var(--sky); font-weight: 400; margin: 0 0.12em; }

      nav.sub { display: flex; flex-wrap: wrap; gap: 0.25rem 1.4rem; }
      nav.sub a {
        font-size: 0.86rem;
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
        padding: 0.2rem 0;
        border-bottom: 2px solid transparent;
      }
      nav.sub a:hover { border-bottom-color: var(--rule); }
      nav.sub a[aria-current='page'] { border-bottom-color: var(--teal); }

      .topbar-rule {
        max-width: var(--page-max);
        margin: 0 auto;
        padding: 0 var(--gutter);
      }
      .topbar-rule hr { margin: 0; border: 0; height: 1px; background: var(--rule); }

      /* ---- Content ---- */
      main {
        max-width: var(--page-max);
        margin: 0 auto;
        padding: clamp(2rem, 5vw, 3.5rem) var(--gutter) clamp(3rem, 6vw, 5rem);
        min-height: 60vh;
      }
      h1, h2 { font-family: var(--font-display); text-wrap: balance; color: var(--ink); }
      h1 {
        font-weight: 600;
        font-size: clamp(2.3rem, 5.5vw, 3.6rem);
        line-height: 1.05;
        letter-spacing: -0.01em;
        margin: 0 0 1.25rem;
        max-width: 20ch;
      }
      h2 {
        font-weight: 600;
        font-size: clamp(1.5rem, 2.6vw, 1.95rem);
        line-height: 1.15;
        margin: 2.75rem 0 0.9rem;
      }
      h3 { font-family: var(--font-body); font-weight: 600; font-size: 1.05rem; margin: 0 0 0.4rem; }
      p { margin: 0 0 1rem; max-width: 64ch; }
      .lede { font-size: 1.15rem; line-height: 1.55; color: var(--ink-soft); max-width: 56ch; }
      .muted { color: var(--ink-soft); }
      .eyebrow {
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--teal);
        margin: 0 0 0.6rem;
      }
      .grad-text {
        background: var(--grad);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        /* fallback colour if background-clip:text is unsupported */
        -webkit-text-fill-color: transparent;
      }
      @supports not ((background-clip: text) or (-webkit-background-clip: text)) {
        .grad-text { color: var(--teal); -webkit-text-fill-color: currentColor; }
      }

      .pill {
        display: inline-block;
        padding: 0.65rem 1.4rem;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.95rem;
        line-height: 1.3;
      }
      .pill-grad { background: var(--grad); color: var(--ink); }
      .pill-outline { background: var(--card); border: 2px solid var(--lime); color: var(--ink); }
      .pill-outline strong { margin-right: 0.4rem; color: var(--coral); text-transform: uppercase; letter-spacing: 0.04em; }

      .empty {
        padding: 1.5rem 1.75rem;
        background: var(--card);
        border: 1px solid var(--rule);
        border-radius: 14px;
        margin-top: 1.75rem;
        max-width: 42rem;
        color: var(--ink-soft);
      }
      .empty p:last-child { margin-bottom: 0; }

      /* ---- Footer ---- */
      footer.site {
        max-width: var(--page-max);
        margin: 0 auto;
        padding: 0 var(--gutter) 2.5rem;
        font-size: 0.84rem;
        color: var(--ink-soft);
      }
      footer.site .row {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem 2rem;
        flex-wrap: wrap;
        padding-top: 1.25rem;
      }
      footer.site .fmark { font-family: var(--font-display); font-weight: 600; color: var(--ink); font-size: 1rem; }

      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="topbar">
        <div class="left">
          <a class="back" href={url('/')}>↩ ESPG</a>
          <a class="mini-mark" href={url('/conference')}>VUEESC<span class="x">×</span>GESSS</a>
        </div>
        <nav class="sub" aria-label="Conference sections">
          {
            nav.map((item) => (
              <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
      <div class="topbar-rule"><hr /></div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site">
      <div class="topbar-rule" style="padding:0"><hr /></div>
      <div class="row">
        <span><span class="fmark">VUEESC × GESSS 2026</span> · 5–6 November · McCoy Building Lv. 2, University of Melbourne</span>
        <span>Hosted by <a href={url('/')}>ESPG</a></span>
      </div>
    </footer>
  </body>
</html>
