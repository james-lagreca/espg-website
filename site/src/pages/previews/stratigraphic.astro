---
import { url } from '../../lib/url';

// Upcoming events — full register
const events = [
  { date: '2026-07-15', dd: '15', mo: 'Jul', wd: 'Wed', title: 'Welcome BBQ',                       loc: 'South Lawn · Parkville',     kind: 'Social'     },
  { date: '2026-08-22', dd: '22', mo: 'Aug', wd: 'Sat', title: 'Pub night & cohort mixer',          loc: 'Naughtons Hotel · Carlton',  kind: 'Social'     },
  { date: '2026-09-12', dd: '12', mo: 'Sep', wd: 'Sat', title: 'Field trip — Otway Ranges',         loc: 'Otway Ranges · 2 days',      kind: 'Field'      },
  { date: '2026-10-18', dd: '18', mo: 'Oct', wd: 'Sun', title: 'Annual Postgraduate Conference',    loc: 'Parkville · 3 days',         kind: 'Conference' },
  { date: '2026-11-14', dd: '14', mo: 'Nov', wd: 'Sat', title: 'Reading group — neotectonics',      loc: 'McCoy Building',             kind: 'Academic'   },
  { date: '2026-12-06', dd: '06', mo: 'Dec', wd: 'Sun', title: 'End-of-year dinner',                loc: 'Lygon St · TBC',             kind: 'Social'     },
];

// Featured (most-immediate three for the masthead strip)
const featured = events.slice(0, 3);

/**
 * International Chronostratigraphic Chart (ICS 2023) — colours and bounds.
 * Proportional thickness: total = 4567 Ma (Hadean start).
 * Stored as % FROM TOP (where 0 = now, 100 = formation of Earth).
 */
const timeScale = [
  // Phanerozoic — eras
  { kind: 'era', name: 'Cenozoic',    fromMa:   66.0, toMa:    0.0, color: '#F2F91D' },
  { kind: 'era', name: 'Mesozoic',    fromMa:  251.9, toMa:   66.0, color: '#67C5CA' },
  { kind: 'era', name: 'Paleozoic',   fromMa:  538.8, toMa:  251.9, color: '#99C08D' },
  // Pre-Phanerozoic — eons
  { kind: 'eon', name: 'Proterozoic', fromMa: 2500.0, toMa:  538.8, color: '#F73DC2' },
  { kind: 'eon', name: 'Archean',     fromMa: 4000.0, toMa: 2500.0, color: '#F0047F' },
  { kind: 'eon', name: 'Hadean',      fromMa: 4567.0, toMa: 4000.0, color: '#AB145A' },
];
const TOTAL_MA = 4567.0;
// Pre-compute % positions
const bands = timeScale.map((t) => ({
  ...t,
  topPct: (t.toMa / TOTAL_MA) * 100,
  bottomPct: (t.fromMa / TOTAL_MA) * 100,
  heightPct: ((t.fromMa - t.toMa) / TOTAL_MA) * 100,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ESPG · Direction B (v2) — Stratigraphic Modern</title>
    <link rel="icon" type="image/svg+xml" href={url('/espg-logo.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Hanken+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #18191a;
        --bg-warm: #1d1e1c;
        --bg-cool: #161819;
        --bg-card: #1f2122;
        --bone: #e6e1d6;
        --bone-soft: #a6a097;
        --muted: #6a655c;
        --copper: #d07636;
        --copper-soft: #9a5526;
        --copper-bright: #e88a45;
        --moss: #4a5c33;
        --rule: #2e2f30;
        --rule-warm: #3a3530;

        /* Layout */
        --time-col: 7.5rem; /* total width allotted to the time scale column */
      }

      *,
      *::before,
      *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--bone);
        font-family: 'Hanken Grotesk', system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.55;
        font-weight: 400;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }

      /* Atmospheric contour lines — subtle topo bg */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.5;
        z-index: 0;
        background-image:
          radial-gradient(ellipse 80% 60% at 25% 35%, transparent 30%, rgba(208, 118, 54, 0.045) 30.3%, transparent 30.6%),
          radial-gradient(ellipse 80% 60% at 25% 35%, transparent 40%, rgba(208, 118, 54, 0.04)  40.3%, transparent 40.6%),
          radial-gradient(ellipse 80% 60% at 25% 35%, transparent 50%, rgba(208, 118, 54, 0.035) 50.3%, transparent 50.6%),
          radial-gradient(ellipse 80% 60% at 75% 75%, transparent 25%, rgba(74, 92, 51, 0.045)  25.3%, transparent 25.6%),
          radial-gradient(ellipse 80% 60% at 75% 75%, transparent 35%, rgba(74, 92, 51, 0.04)   35.3%, transparent 35.6%),
          radial-gradient(ellipse 80% 60% at 75% 75%, transparent 45%, rgba(74, 92, 51, 0.035)  45.3%, transparent 45.6%);
      }

      a {
        color: var(--bone);
        text-decoration: none;
        transition: color 180ms ease;
      }
      a:hover { color: var(--copper); }

      /* TOP UTILITY BAR */
      .util {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 60;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.9rem clamp(1.25rem, 4vw, 3rem) 0.9rem calc(var(--time-col) + 1rem);
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--bone-soft);
        background: linear-gradient(to bottom, rgba(24,25,26,0.92) 50%, transparent);
        pointer-events: none;
        backdrop-filter: blur(2px);
      }
      .util a { color: var(--bone-soft); pointer-events: auto; }
      .util a:hover { color: var(--copper); }
      .util .dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--copper);
        margin-right: 0.5rem;
        vertical-align: 1px;
        box-shadow: 0 0 10px var(--copper);
      }

      /* === GEOLOGICAL TIME SCALE COLUMN (fixed, left edge) === */
      .gts {
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        width: var(--time-col);
        z-index: 40;
        pointer-events: none;
        padding: 1rem 0.75rem 1.25rem 1rem;
        display: flex;
        gap: 0.6rem;
        border-right: 1px solid var(--rule);
        background: linear-gradient(to right, rgba(0,0,0,0.25), transparent);
      }
      .gts-col {
        position: relative;
        width: 22px;
        flex: 0 0 22px;
        border: 1px solid var(--rule-warm);
        background: var(--bg-cool);
        overflow: hidden;
      }
      .gts-band {
        position: absolute;
        left: 0;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .gts-band::after {
        /* horizontal hairline at boundary */
        content: '';
        position: absolute;
        left: -2px;
        right: -2px;
        top: 0;
        height: 1px;
        background: rgba(0,0,0,0.35);
      }
      .gts-band:first-child::after { display: none; }

      /* "You are here" marker — at the very top of the column (now) */
      .gts-now {
        position: absolute;
        left: -10px;
        top: 0;
        width: 16px;
        height: 16px;
        background: var(--copper);
        border: 2px solid var(--bg);
        border-radius: 50%;
        box-shadow: 0 0 14px var(--copper);
        z-index: 2;
        animation: pulse 2.4s ease-in-out infinite;
      }
      @keyframes pulse {
        0%, 100% { box-shadow: 0 0 10px rgba(208,118,54,0.6); }
        50%      { box-shadow: 0 0 22px rgba(208,118,54,0.95); }
      }

      .gts-labels {
        position: relative;
        flex: 1;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.6rem;
        line-height: 1.25;
        letter-spacing: 0.05em;
        color: var(--bone-soft);
      }
      .gts-label {
        position: absolute;
        left: 0;
        right: 0;
        padding-left: 0.4rem;
        transform: translateY(-50%); /* anchor at vertical centre of band */
      }
      .gts-label .nm {
        display: block;
        color: var(--bone);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.62rem;
        font-weight: 500;
      }
      .gts-label .age {
        display: block;
        color: var(--muted);
        font-size: 0.58rem;
        margin-top: 1px;
      }
      .gts-label::before {
        /* leader line back to the band */
        content: '';
        position: absolute;
        left: -0.6rem;
        top: 50%;
        width: 0.4rem;
        height: 1px;
        background: var(--rule);
      }
      .gts-now-label {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        padding-left: 0.4rem;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.6rem;
        line-height: 1.1;
        color: var(--copper);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .gts-now-label .yr {
        display: block;
        color: var(--bone-soft);
        text-transform: none;
        letter-spacing: 0.04em;
        margin-top: 1px;
      }
      .gts-footer {
        position: absolute;
        left: 1rem;
        right: 0.75rem;
        bottom: 0.5rem;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.55rem;
        line-height: 1.3;
        letter-spacing: 0.08em;
        color: var(--muted);
        text-transform: uppercase;
      }

      @media (max-width: 860px) {
        :root { --time-col: 0; }
        .gts { display: none; }
        .util { padding-left: 1.25rem; }
      }

      /* === PAGE === */
      .page {
        position: relative;
        z-index: 1;
        max-width: 80rem;
        margin: 0 auto;
        padding: 0 clamp(1.5rem, 4vw, 3rem) 4rem calc(var(--time-col) + clamp(1.5rem, 3vw, 2.5rem));
      }
      @media (max-width: 860px) { .page { padding-left: clamp(1.25rem, 5vw, 2rem); padding-top: 3.5rem; } }

      /* === MASTHEAD === */
      .mast {
        padding: clamp(3.5rem, 7vw, 5rem) 0 clamp(2rem, 4vw, 3rem);
        border-bottom: 1px solid var(--rule);
      }
      .mast-top {
        display: grid;
        grid-template-columns: minmax(0, auto) minmax(0, 1fr) minmax(0, auto);
        gap: clamp(1.25rem, 3vw, 2.5rem);
        align-items: center;
      }
      .specimen {
        position: relative;
        width: clamp(74px, 9vw, 104px);
        aspect-ratio: 1;
        flex: 0 0 auto;
      }
      .specimen::before {
        content: '';
        position: absolute;
        inset: -8px;
        border-radius: 50%;
        border: 1px solid var(--rule-warm);
      }
      .specimen-disc {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 30%, #f7f2e6 0%, #ebe4d2 70%, #d6cdb6 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow:
          inset 0 0 0 1px rgba(0,0,0,0.06),
          inset 0 6px 18px rgba(0,0,0,0.08),
          0 8px 32px rgba(0,0,0,0.35);
      }
      .specimen-disc img {
        width: 78%;
        height: 78%;
        object-fit: contain;
        display: block;
      }
      .specimen-label {
        position: absolute;
        left: 50%;
        bottom: -1.8rem;
        transform: translateX(-50%);
        white-space: nowrap;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.58rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .mast-text { min-width: 0; }
      .mast-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--copper);
        margin-bottom: 0.6rem;
      }
      .mast-eyebrow::before {
        content: '';
        display: inline-block;
        width: 1.6rem;
        height: 1px;
        background: var(--copper);
      }
      h1.wordmark {
        font-family: 'Bricolage Grotesque', system-ui, sans-serif;
        font-variation-settings: 'opsz' 96, 'wdth' 100, 'wght' 600;
        font-size: clamp(2.2rem, 5.6vw, 4.2rem);
        line-height: 0.95;
        letter-spacing: -0.035em;
        margin: 0 0 0.4rem;
      }
      h1.wordmark .ital {
        font-style: italic;
        font-variation-settings: 'opsz' 96, 'wdth' 95, 'wght' 400;
        color: var(--copper);
      }
      .mast-sub {
        font-family: 'Bricolage Grotesque', system-ui, sans-serif;
        font-variation-settings: 'opsz' 24, 'wdth' 90, 'wght' 400;
        font-size: clamp(0.95rem, 1.4vw, 1.1rem);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--bone-soft);
        margin: 0;
      }

      .mast-cta {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.5rem;
      }
      @media (max-width: 720px) {
        .mast-top { grid-template-columns: minmax(0, auto) minmax(0, 1fr); }
        .mast-cta { grid-column: 1 / -1; align-items: stretch; flex-direction: row; }
      }

      .cta {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.85rem 1.3rem;
        background: var(--copper);
        color: #18191a;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 500;
        border: none;
        transition: background 200ms ease, transform 200ms ease;
        white-space: nowrap;
      }
      .cta:hover {
        background: var(--copper-bright);
        color: #18191a;
        transform: translateY(-1px);
      }
      .cta--ghost {
        background: transparent;
        color: var(--bone);
        border: 1px solid var(--rule-warm);
      }
      .cta--ghost:hover {
        background: transparent;
        color: var(--copper);
        border-color: var(--copper);
      }
      .cta .arrow { transition: transform 200ms ease; }
      .cta:hover .arrow { transform: translateX(4px); }
      .cta-aside {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.66rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .mast-lede {
        margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
        font-size: clamp(1.05rem, 1.45vw, 1.25rem);
        line-height: 1.45;
        max-width: 58ch;
        color: var(--bone);
      }
      .mast-lede strong { color: var(--copper); font-weight: 500; }

      .mast-nav {
        margin-top: clamp(1.5rem, 3vw, 2.5rem);
        padding: 0.9rem 0;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.75rem;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.78rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      .mast-nav a { color: var(--bone); }
      .mast-nav a:hover { color: var(--copper); }

      /* Quick-look "Next up" strip directly under masthead */
      .nextup {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
        gap: 1px;
        background: var(--rule);
        border: 1px solid var(--rule);
        margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
      }
      .nextup-tag {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.66rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--copper);
        margin: clamp(1.5rem, 3vw, 2.5rem) 0 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .nextup-tag::before {
        content: '';
        width: 1rem;
        height: 1px;
        background: var(--copper);
      }
      .nextup a {
        background: var(--bg);
        padding: 1.2rem 1.2rem 1.1rem;
        display: block;
        text-decoration: none;
        color: var(--bone);
        transition: background 180ms ease;
      }
      .nextup a:hover { background: var(--bg-card); color: var(--bone); }
      .nextup .day-row {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.72rem;
        color: var(--copper);
        letter-spacing: 0.06em;
        margin-bottom: 0.3rem;
      }
      .nextup .day-row .yr { color: var(--muted); }
      .nextup .nu-title {
        font-family: 'Bricolage Grotesque', system-ui, sans-serif;
        font-variation-settings: 'opsz' 22, 'wdth' 100, 'wght' 500;
        font-size: 1.05rem;
        letter-spacing: -0.01em;
        line-height: 1.2;
        margin: 0 0 0.25rem;
      }
      .nextup .nu-loc {
        font-size: 0.83rem;
        color: var(--bone-soft);
      }

      /* === SECTIONS === */
      section {
        position: relative;
        padding: clamp(3rem, 6vw, 5rem) 0;
        border-bottom: 1px solid var(--rule);
      }
      section.warm {
        background: var(--bg-warm);
        margin: 0 calc(-1 * clamp(1.5rem, 4vw, 3rem));
        padding-left: clamp(1.5rem, 4vw, 3rem);
        padding-right: clamp(1.5rem, 4vw, 3rem);
      }
      section.cool {
        background: var(--bg-cool);
        margin: 0 calc(-1 * clamp(1.5rem, 4vw, 3rem));
        padding-left: clamp(1.5rem, 4vw, 3rem);
        padding-right: clamp(1.5rem, 4vw, 3rem);
      }
      .sect-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--copper);
        margin-bottom: clamp(0.8rem, 1.5vw, 1.25rem);
      }
      .sect-tag::before {
        content: '';
        display: inline-block;
        width: 1.8rem;
        height: 1px;
        background: var(--copper);
      }
      h2 {
        font-family: 'Bricolage Grotesque', system-ui, sans-serif;
        font-variation-settings: 'opsz' 60, 'wdth' 100, 'wght' 500;
        font-size: clamp(1.85rem, 3.8vw, 2.9rem);
        line-height: 1;
        letter-spacing: -0.025em;
        margin: 0 0 1rem;
        max-width: 24ch;
      }
      h2 em {
        font-style: italic;
        font-variation-settings: 'opsz' 60, 'wdth' 95, 'wght' 400;
        color: var(--copper);
      }
      .muted { color: var(--bone-soft); }
      p { margin: 0 0 1rem; max-width: 60ch; }

      /* === FULL EVENTS REGISTER === */
      .register {
        list-style: none;
        margin: 1.25rem 0 0;
        padding: 0;
        border-top: 1px solid var(--rule);
      }
      .register li {
        display: grid;
        grid-template-columns: minmax(0, 4.5rem) minmax(0, 1fr) minmax(0, auto);
        gap: clamp(1rem, 2vw, 2rem);
        padding: 1.25rem 0;
        border-bottom: 1px solid var(--rule);
        align-items: center;
        transition: background 160ms;
      }
      .register li:hover { background: rgba(208, 118, 54, 0.04); }
      .reg-date {
        font-family: 'Bricolage Grotesque', system-ui, sans-serif;
        font-variation-settings: 'opsz' 60, 'wdth' 95, 'wght' 600;
        font-size: clamp(2.2rem, 4vw, 3rem);
        line-height: 0.85;
        letter-spacing: -0.025em;
        color: var(--bone);
      }
      .reg-date .mo {
        display: block;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-variation-settings: normal;
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--copper);
        margin-top: 0.35rem;
        font-weight: 500;
      }
      .reg-mid h3 {
        font-family: 'Bricolage Grotesque', system-ui, sans-serif;
        font-variation-settings: 'opsz' 24, 'wdth' 100, 'wght' 500;
        font-size: clamp(1.05rem, 1.5vw, 1.2rem);
        letter-spacing: -0.005em;
        line-height: 1.2;
        margin: 0 0 0.2rem;
      }
      .reg-mid .loc {
        font-size: 0.86rem;
        color: var(--bone-soft);
      }
      .reg-kind {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.66rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--bone-soft);
        white-space: nowrap;
      }
      @media (max-width: 720px) {
        .register li { grid-template-columns: minmax(0, 4.5rem) 1fr; row-gap: 0.5rem; }
        .reg-kind { grid-column: 1 / -1; }
      }

      /* === MEMBERSHIP block === */
      .join-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(2rem, 4vw, 3.5rem);
        margin-top: 0.75rem;
      }
      @media (max-width: 720px) { .join-grid { grid-template-columns: 1fr; } }
      .join-pills {
        list-style: none;
        margin: 1.25rem 0 1.75rem;
        padding: 0;
        display: grid;
        gap: 0.6rem;
      }
      .join-pills li {
        display: grid;
        grid-template-columns: minmax(0, auto) minmax(0, 1fr);
        gap: 0.85rem;
        align-items: baseline;
      }
      .join-pills .ix {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.72rem;
        color: var(--copper);
        letter-spacing: 0.06em;
        font-weight: 500;
      }
      .join-pills .it { font-size: 0.98rem; line-height: 1.4; }

      .join-card {
        padding: clamp(1.5rem, 3vw, 2.25rem);
        border: 1px solid var(--rule-warm);
        background: linear-gradient(180deg, rgba(208, 118, 54, 0.08), transparent 75%);
        position: relative;
      }
      .join-card::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: var(--copper);
      }
      .join-stat {
        display: grid;
        grid-template-columns: minmax(0, auto) minmax(0, 1fr);
        gap: 0.6rem 1rem;
        margin: 0;
        padding: 0;
        font-size: 0.9rem;
      }
      .join-stat dt {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--bone-soft);
        align-self: center;
        white-space: nowrap;
      }
      .join-stat dd { margin: 0; }
      .join-stat dd strong {
        font-family: 'Bricolage Grotesque', system-ui, sans-serif;
        font-variation-settings: 'opsz' 24, 'wdth' 100, 'wght' 500;
        font-size: 1.05rem;
        color: var(--copper);
      }

      /* === CONFERENCE === */
      .conf-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
        gap: clamp(2rem, 4vw, 3.5rem);
        align-items: start;
      }
      @media (max-width: 720px) { .conf-grid { grid-template-columns: 1fr; } }
      .conf-card {
        padding: clamp(1.5rem, 3vw, 2.25rem);
        border: 1px solid var(--rule-warm);
        background: var(--bg-card);
      }
      .conf-card dl {
        display: grid;
        grid-template-columns: minmax(0, auto) minmax(0, 1fr);
        gap: 0.7rem 1.5rem;
        margin: 0;
        font-size: 0.92rem;
      }
      .conf-card dt {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--bone-soft);
        align-self: center;
        white-space: nowrap;
      }
      .conf-card dd { margin: 0; }
      .conf-card dd strong {
        font-family: 'Bricolage Grotesque', system-ui, sans-serif;
        font-variation-settings: 'opsz' 24, 'wdth' 100, 'wght' 500;
        font-size: 1.05rem;
        color: var(--copper);
      }

      /* === COMMITTEE === */
      .committee-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
        gap: 1px;
        background: var(--rule);
        border: 1px solid var(--rule);
        margin-top: 1.5rem;
      }
      .committee-grid li {
        list-style: none;
        background: var(--bg);
        padding: 1.1rem 1.2rem;
      }
      .committee-grid .role {
        display: block;
        font-family: 'Bricolage Grotesque', system-ui, sans-serif;
        font-variation-settings: 'opsz' 24, 'wdth' 100, 'wght' 500;
        font-size: 1rem;
        letter-spacing: -0.005em;
        margin-bottom: 0.15rem;
      }
      .committee-grid .desc {
        font-size: 0.83rem;
        color: var(--bone-soft);
      }

      /* === FOOTER === */
      footer.colophon {
        margin-top: clamp(3rem, 6vw, 5rem);
        padding-top: 2rem;
        border-top: 1px solid var(--copper-soft);
        display: grid;
        grid-template-columns: minmax(0, auto) minmax(0, 1fr);
        gap: clamp(1.5rem, 3vw, 2.5rem);
        align-items: start;
      }
      @media (max-width: 720px) { footer.colophon { grid-template-columns: 1fr; } }
      .foot-logo {
        width: clamp(54px, 6vw, 78px);
        aspect-ratio: 1;
        background: var(--bone);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0.85;
      }
      .foot-logo img { width: 78%; height: 78%; object-fit: contain; }
      footer .colophon-text {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.7rem;
        line-height: 1.7;
        letter-spacing: 0.06em;
        color: var(--bone-soft);
        text-transform: uppercase;
        margin: 0;
        max-width: 80ch;
      }
      footer .colophon-text strong { color: var(--bone); font-weight: 500; }

      /* === Reveals === */
      .reveal {
        opacity: 0;
        transform: translateX(-12px);
        animation: slide 700ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
      }
      .reveal:nth-child(1) { animation-delay: 60ms; }
      .reveal:nth-child(2) { animation-delay: 140ms; }
      .reveal:nth-child(3) { animation-delay: 220ms; }
      .reveal:nth-child(4) { animation-delay: 300ms; }
      .reveal:nth-child(5) { animation-delay: 380ms; }
      @keyframes slide { to { opacity: 1; transform: translateX(0); } }
    </style>
  </head>
  <body>
    <div class="util">
      <span><span class="dot" aria-hidden="true"></span>ESPG · Direction B (v2) · Stratigraphic Modern</span>
      <a href={url('/previews')}>← all directions</a>
    </div>

    <!-- GEOLOGICAL TIME SCALE — fixed left column -->
    <aside class="gts" aria-label="Geological time scale">
      <div class="gts-col">
        {
          bands.map((b) => (
            <div
              class="gts-band"
              style={`top: ${b.topPct}%; height: ${b.heightPct}%; background: ${b.color};`}
              title={`${b.name} — ${b.fromMa} to ${b.toMa} Ma`}
            />
          ))
        }
        <div class="gts-now" aria-hidden="true"></div>
      </div>

      <div class="gts-labels">
        <div class="gts-now-label">
          ● Now<span class="yr">2026 CE</span>
        </div>
        {
          bands.map((b) => {
            // Place label at vertical centre of the band
            const centrePct = b.topPct + b.heightPct / 2;
            // For very thin Phanerozoic bands at top, push label down so they don't pile up under "Now"
            const safeTop = b.name === 'Cenozoic' ? 6.5 :
                            b.name === 'Mesozoic' ? 10.5 :
                            b.name === 'Paleozoic' ? 15.5 :
                            centrePct;
            return (
              <div class="gts-label" style={`top: ${safeTop}%;`}>
                <span class="nm">{b.name}</span>
                <span class="age">{b.fromMa.toFixed(1).replace(/\.0$/, '')} Ma</span>
              </div>
            );
          })
        }
        <div class="gts-footer">ICS chart · proportional · 4,567 Ma</div>
      </div>
    </aside>

    <main class="page">
      <!-- MASTHEAD -->
      <header class="mast">
        <div class="mast-top">
          <div class="specimen reveal">
            <div class="specimen-disc">
              <img src={url('/espg-logo.svg')} alt="ESPG logo" />
            </div>
            <span class="specimen-label">Specimen · est. 2007</span>
          </div>
          <div class="mast-text reveal">
            <p class="mast-eyebrow">Earth Sciences Postgraduate Group · UoM</p>
            <h1 class="wordmark">ESPG<span class="ital">.</span></h1>
            <p class="mast-sub">A postgraduate community in deep time.</p>
          </div>
          <div class="mast-cta reveal">
            <a href="#join" class="cta">Join the society <span class="arrow">→</span></a>
            <span class="cta-aside">Free · 1-minute sign-up</span>
          </div>
        </div>

        <p class="mast-lede reveal">
          Built by postgrads, for postgrads — across geology, geophysics, atmospheric and
          environmental sciences. <strong>A low-stakes venue</strong> for work-in-progress,
          fieldwork, and the people you'll be at conferences with for the next decade.
        </p>

        <nav class="mast-nav reveal">
          <a href="#events">Events</a>
          <a href="#join">Membership</a>
          <a href="#conference">Conference</a>
          <a href="#committee">Committee</a>
          <a href="#colophon">About</a>
        </nav>

        <p class="nextup-tag">Next up — three closest dates</p>
        <div class="nextup">
          {
            featured.map((e) => (
              <a href="#events">
                <div class="day-row">
                  <span>{e.dd} {e.mo}</span>
                  <span class="yr">'26 · {e.wd}</span>
                </div>
                <h3 class="nu-title">{e.title}</h3>
                <div class="nu-loc">{e.loc}</div>
              </a>
            ))
          }
        </div>
      </header>

      <!-- EVENTS — full register -->
      <section id="events">
        <p class="sect-tag">Register</p>
        <h2>Upcoming events, <em>tabulated.</em></h2>
        <p class="muted">Six dates across the next six months. Hover for highlight.</p>
        <ol class="register">
          {
            events.map((e) => (
              <li>
                <span class="reg-date">
                  {e.dd}<span class="mo">{e.mo} '26</span>
                </span>
                <div class="reg-mid">
                  <h3>{e.title}</h3>
                  <span class="loc">{e.wd} · {e.loc}</span>
                </div>
                <span class="reg-kind">{e.kind}</span>
              </li>
            ))
          }
        </ol>
        <div style="margin-top: 1.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
          <a href="#" class="cta cta--ghost">Full register <span class="arrow">→</span></a>
          <span class="cta-aside">Subscribe to event emails when you join.</span>
        </div>
      </section>

      <!-- MEMBERSHIP -->
      <section class="warm" id="join">
        <p class="sect-tag">Membership</p>
        <h2>Free. <em>For any postgrad</em> in the school.</h2>
        <div class="join-grid">
          <div>
            <p>
              Membership takes about a minute to sign up. There are no fees, no formal
              commitments, and you can stay on the mailing list for as long as you're a
              postgraduate in SGEAS.
            </p>
            <ul class="join-pills">
              <li><span class="ix">01</span><span class="it">Event emails — BBQs, field trips, pub nights, conferences.</span></li>
              <li><span class="ix">02</span><span class="it">Conference call for abstracts each August.</span></li>
              <li><span class="ix">03</span><span class="it">School-level representation through the HDR rep.</span></li>
              <li><span class="ix">04</span><span class="it">Travel and conference bursaries (where budget allows).</span></li>
              <li><span class="ix">05</span><span class="it">Occasional opportunities from outside the school.</span></li>
            </ul>
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
              <a href="#" class="cta">Join the society <span class="arrow">→</span></a>
              <a href="#" class="cta cta--ghost">Mailing list only</a>
            </div>
          </div>
          <aside class="join-card">
            <dl class="join-stat">
              <dt>Members</dt>
              <dd><strong>120+</strong> across SGEAS</dd>
              <dt>Cost</dt>
              <dd><strong>Free</strong> for SGEAS HDRs</dd>
              <dt>Events / yr</dt>
              <dd><strong>16</strong> on average</dd>
              <dt>Conference</dt>
              <dd><strong>Annual</strong>, in October</dd>
              <dt>Founded</dt>
              <dd><strong>2007</strong></dd>
              <dt>Affiliated</dt>
              <dd>UMSU GSA</dd>
            </dl>
          </aside>
        </div>
      </section>

      <!-- CONFERENCE -->
      <section id="conference">
        <p class="sect-tag">Conference</p>
        <div class="conf-grid">
          <div>
            <h2>An annual <em>postgraduate</em> conference, in October.</h2>
            <p>
              Three days of HDR-led talks alongside invited keynotes from across the earth
              sciences. The conference is a supportive venue for students to present
              work-in-progress, get feedback from peers, and meet researchers from outside
              their immediate group.
            </p>
            <p class="muted">Registration opens August. Call for abstracts the same week.</p>
            <a href="#" class="cta" style="margin-top: 0.5rem;">Conference details <span class="arrow">→</span></a>
          </div>
          <aside class="conf-card">
            <dl>
              <dt>Dates</dt><dd><strong>18–20 Oct 2026</strong></dd>
              <dt>Location</dt><dd>University of Melbourne, Parkville</dd>
              <dt>Theme</dt><dd>Earth in transition</dd>
              <dt>Keynote</dt><dd>To be announced</dd>
              <dt>Format</dt><dd>Talks · posters · lightning</dd>
              <dt>Abstracts</dt><dd>Open Aug · close Sep</dd>
            </dl>
          </aside>
        </div>
      </section>

      <!-- COMMITTEE -->
      <section class="cool" id="committee">
        <p class="sect-tag">Committee</p>
        <h2>Six elected roles. <em>One year.</em></h2>
        <p class="muted">Voted at the AGM each March. All current postgraduates in SGEAS.</p>
        <ul class="committee-grid">
          <li><span class="role">Chair</span><span class="desc">Direction & external rep</span></li>
          <li><span class="role">Secretary</span><span class="desc">Minutes & comms</span></li>
          <li><span class="role">Treasurer</span><span class="desc">Budget & grants</span></li>
          <li><span class="role">Events</span><span class="desc">BBQs, trips, socials</span></li>
          <li><span class="role">Conference</span><span class="desc">Annual conference</span></li>
          <li><span class="role">HDR rep</span><span class="desc">School-level voice</span></li>
        </ul>
      </section>

      <footer class="colophon" id="colophon">
        <div class="foot-logo"><img src={url('/espg-logo.svg')} alt="" /></div>
        <p class="colophon-text">
          <strong>ESPG</strong> · Earth Sciences Postgraduate Group · School of Geography, Earth
          and Atmospheric Sciences · The University of Melbourne · est. 2007 · Set in Bricolage
          Grotesque (variable opsz · wdth · wght), Hanken Grotesk, JetBrains Mono. Time scale
          after the International Chronostratigraphic Chart (ICS 2023).
        </p>
      </footer>
    </main>
  </body>
</html>
