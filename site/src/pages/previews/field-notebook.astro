---
import { url } from '../../lib/url';

const events = [
  {
    plate: 'I',
    day: 15,
    month: 'JUL',
    year: 2026,
    title: 'Welcome BBQ',
    location: 'South Lawn · Parkville campus',
    detail: 'Start-of-semester gathering for new and returning earth sciences postgrads.',
  },
  {
    plate: 'II',
    day: 12,
    month: 'SEP',
    year: 2026,
    title: 'Weekend field trip — Otway Ranges',
    location: 'Otway Ranges · Victoria',
    detail:
      'Two days across Otway Group sediments, the Twelve Apostles coastline, and Cretaceous fossil sites.',
  },
  {
    plate: 'III',
    day: 18,
    month: 'OCT',
    year: 2026,
    title: 'Annual Postgraduate Conference',
    location: 'University of Melbourne',
    detail:
      'Three days of HDR-led talks with invited keynotes. Open call for abstracts in August.',
  },
];

const committee = [
  { name: 'Chair', detail: 'Society direction & external rep.' },
  { name: 'Secretary', detail: 'Minutes, mailing list, comms.' },
  { name: 'Treasurer', detail: 'Budget, grants, conference finances.' },
  { name: 'Events officer', detail: 'BBQs, field trips, pub nights.' },
  { name: 'Conference chair', detail: 'Annual postgraduate conference.' },
  { name: 'HDR rep', detail: 'School-level student representation.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ESPG · Direction A — Editorial Field Notebook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --paper: #f1ead9;
        --paper-deep: #e9e1cb;
        --ink: #1c1813;
        --ink-soft: #4a4338;
        --muted: #7a6f5e;
        --rule: #b9af96;
        --ochre: #a8651a;
        --ochre-deep: #864e10;
        --measure: 62ch;
      }

      *,
      *::before,
      *::after { box-sizing: border-box; }

      html { -webkit-text-size-adjust: 100%; }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: 'Newsreader', 'Iowan Old Style', Georgia, serif;
        font-optical-sizing: auto;
        font-size: 18px;
        line-height: 1.55;
        font-feature-settings: 'kern', 'liga', 'onum';
        font-variant-numeric: oldstyle-nums;
        position: relative;
        overflow-x: hidden;
      }

      /* Paper grain */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        opacity: 0.4;
        mix-blend-mode: multiply;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' seed='4'/><feColorMatrix values='0 0 0 0 0.18  0 0 0 0 0.14  0 0 0 0 0.08  0 0 0 0.10 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
      }

      a { color: var(--ochre); text-decoration: none; }
      a:hover { color: var(--ochre-deep); text-decoration: underline; text-underline-offset: 4px; }

      .running-head {
        position: fixed;
        top: 1.25rem;
        left: 0;
        right: 0;
        z-index: 50;
        display: flex;
        justify-content: space-between;
        padding: 0 clamp(1rem, 4vw, 3rem);
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.68rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
        pointer-events: none;
      }
      .running-head a { color: var(--muted); pointer-events: auto; }
      .running-head a:hover { color: var(--ink); text-decoration: none; }

      .page {
        position: relative;
        z-index: 1;
        max-width: 78rem;
        margin: 0 auto;
        padding: clamp(5rem, 9vw, 8rem) clamp(1.25rem, 5vw, 4rem) 4rem;
      }

      /* MASTHEAD */
      .masthead {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0;
        margin-bottom: clamp(3rem, 6vw, 5rem);
      }
      .eyebrow {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: clamp(1rem, 2vw, 1.5rem);
      }
      .eyebrow::before,
      .eyebrow::after {
        content: '';
        height: 1px;
        background: var(--rule);
        flex: 1;
      }
      .eyebrow::after { display: none; }

      h1.title {
        font-variation-settings: 'opsz' 72;
        font-weight: 460;
        font-size: clamp(2.75rem, 9vw, 6.5rem);
        line-height: 0.92;
        letter-spacing: -0.025em;
        margin: 0 0 1.5rem;
        max-width: 14ch;
      }
      h1.title .amp {
        font-style: italic;
        font-variation-settings: 'opsz' 72;
        font-weight: 350;
        color: var(--ochre);
      }

      .masthead .lede {
        font-variation-settings: 'opsz' 28;
        font-size: clamp(1.2rem, 1.9vw, 1.5rem);
        line-height: 1.4;
        max-width: 52ch;
        margin: 0 0 2rem;
        color: var(--ink-soft);
      }
      .masthead .lede em {
        font-style: italic;
        font-variation-settings: 'opsz' 28;
      }

      .nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem 2rem;
        padding: 1rem 0;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.78rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .nav a { color: var(--ink); }
      .nav a:hover { color: var(--ochre); text-decoration: none; }
      .nav .sep { color: var(--rule); }

      /* PLATE: hero plate caption block */
      .plate {
        margin: clamp(3rem, 6vw, 5rem) 0 clamp(3rem, 6vw, 5rem);
        display: grid;
        grid-template-columns: minmax(0, 14ch) 1fr;
        gap: clamp(1.5rem, 4vw, 3rem);
        align-items: start;
      }
      .plate-meta {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.7rem;
        line-height: 1.6;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        padding-top: 0.5rem;
        border-top: 1px solid var(--rule);
      }
      .plate-meta .num {
        color: var(--ochre);
        font-size: 0.9rem;
        letter-spacing: 0.08em;
      }
      .plate-figure {
        position: relative;
        aspect-ratio: 16 / 9;
        border: 1px solid var(--rule);
        background:
          radial-gradient(ellipse at 30% 20%, rgba(168, 101, 26, 0.18), transparent 60%),
          radial-gradient(ellipse at 70% 80%, rgba(60, 74, 42, 0.18), transparent 65%),
          linear-gradient(135deg, var(--paper-deep) 0%, #d8cdb0 100%);
        overflow: hidden;
      }
      .plate-figure::before {
        /* Topographic contour lines */
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          radial-gradient(ellipse 60% 50% at 40% 60%, transparent 28%, rgba(28,24,19,0.18) 28.5%, transparent 29%),
          radial-gradient(ellipse 60% 50% at 40% 60%, transparent 38%, rgba(28,24,19,0.14) 38.5%, transparent 39%),
          radial-gradient(ellipse 60% 50% at 40% 60%, transparent 48%, rgba(28,24,19,0.10) 48.5%, transparent 49%),
          radial-gradient(ellipse 60% 50% at 40% 60%, transparent 58%, rgba(28,24,19,0.08) 58.5%, transparent 59%),
          radial-gradient(ellipse 60% 50% at 40% 60%, transparent 68%, rgba(28,24,19,0.06) 68.5%, transparent 69%);
      }
      .plate-figure::after {
        content: 'fig. i';
        position: absolute;
        bottom: 0.5rem;
        right: 0.75rem;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }
      .plate-caption {
        margin-top: 0.75rem;
        font-variation-settings: 'opsz' 14;
        font-size: 0.92rem;
        line-height: 1.5;
        color: var(--ink-soft);
        max-width: 50ch;
      }
      .plate-caption strong {
        font-weight: 500;
        color: var(--ink);
      }

      /* SECTION: marginalia layout */
      section.spread {
        display: grid;
        grid-template-columns: minmax(0, 14ch) minmax(0, 1fr);
        gap: clamp(1.5rem, 4vw, 3rem);
        margin: clamp(3rem, 6vw, 5rem) 0;
      }
      .margin {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.68rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        line-height: 1.6;
        padding-top: 0.5rem;
        border-top: 1px solid var(--ink);
      }
      .margin .num {
        display: block;
        color: var(--ochre);
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
        letter-spacing: 0.08em;
      }
      .body {
        max-width: var(--measure);
      }
      h2 {
        font-variation-settings: 'opsz' 48;
        font-weight: 400;
        font-size: clamp(1.75rem, 3.5vw, 2.5rem);
        line-height: 1.05;
        letter-spacing: -0.015em;
        margin: 0 0 1.25rem;
      }
      h2 em {
        font-style: italic;
        font-variation-settings: 'opsz' 48;
        font-weight: 350;
        color: var(--ochre);
      }
      p { margin: 0 0 1rem; }

      /* Drop cap */
      .dropcap::first-letter {
        font-variation-settings: 'opsz' 72;
        font-weight: 400;
        font-size: 5.2rem;
        line-height: 0.85;
        float: left;
        padding: 0.45rem 0.55rem 0 0;
        margin-top: 0.05em;
        color: var(--ochre);
      }

      /* Events register */
      .register {
        list-style: none;
        padding: 0;
        margin: 1rem 0 0;
      }
      .register li {
        display: grid;
        grid-template-columns: minmax(0, 5ch) 1fr minmax(0, 5ch);
        gap: clamp(1rem, 2vw, 1.75rem);
        padding: 1.25rem 0;
        border-top: 1px solid var(--rule);
        align-items: baseline;
      }
      .register li:last-child { border-bottom: 1px solid var(--rule); }
      .reg-day {
        font-variation-settings: 'opsz' 60;
        font-weight: 400;
        font-size: clamp(2.5rem, 5vw, 3.5rem);
        line-height: 0.85;
        font-feature-settings: 'lnum';
        font-variant-numeric: lining-nums;
        color: var(--ink);
        letter-spacing: -0.02em;
      }
      .reg-mid h3 {
        font-variation-settings: 'opsz' 24;
        font-weight: 460;
        font-size: clamp(1.1rem, 1.6vw, 1.25rem);
        line-height: 1.2;
        margin: 0 0 0.25rem;
      }
      .reg-mid p {
        font-size: 0.92rem;
        color: var(--ink-soft);
        margin: 0;
        max-width: 50ch;
      }
      .reg-where {
        display: block;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0.35rem 0 0;
      }
      .reg-plate {
        text-align: right;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
        line-height: 1.4;
      }
      .reg-plate .my {
        display: block;
        font-size: 0.7rem;
        color: var(--muted);
        margin-top: 0.25rem;
      }

      /* Ornamental divider */
      .ornament {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin: clamp(4rem, 7vw, 6rem) auto;
        max-width: 22rem;
        color: var(--rule);
      }
      .ornament::before,
      .ornament::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--rule);
      }
      .ornament svg { width: 18px; height: 18px; color: var(--ochre); }

      /* Pull quote */
      .pull {
        margin: clamp(2rem, 4vw, 3rem) 0;
        padding: 0 clamp(1rem, 3vw, 2.5rem);
        border-left: 1px solid var(--ochre);
      }
      .pull blockquote {
        margin: 0;
        font-style: italic;
        font-variation-settings: 'opsz' 56;
        font-weight: 350;
        font-size: clamp(1.4rem, 2.5vw, 2rem);
        line-height: 1.25;
        color: var(--ink);
        max-width: 30ch;
      }
      .pull cite {
        display: block;
        margin-top: 1rem;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-style: normal;
        font-size: 0.7rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* Committee table */
      .committee {
        list-style: none;
        padding: 0;
        margin: 1rem 0 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
        gap: 0;
        border-top: 1px solid var(--rule);
      }
      .committee li {
        padding: 1rem 1rem 1rem 0;
        border-bottom: 1px solid var(--rule);
      }
      .committee li .role {
        font-variation-settings: 'opsz' 24;
        font-weight: 500;
        font-size: 1.05rem;
        display: block;
        margin-bottom: 0.15rem;
      }
      .committee li .desc {
        font-size: 0.88rem;
        color: var(--ink-soft);
      }

      /* CTA */
      .cta-row {
        margin-top: 2rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2rem;
        align-items: baseline;
      }
      .cta {
        display: inline-flex;
        align-items: baseline;
        gap: 0.6rem;
        padding: 0.85rem 1.4rem;
        background: var(--ink);
        color: var(--paper);
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.78rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        border: 1px solid var(--ink);
      }
      .cta:hover {
        background: var(--ochre);
        border-color: var(--ochre);
        color: var(--paper);
        text-decoration: none;
      }
      .cta .arrow { transform: translateX(0); transition: transform 200ms ease; }
      .cta:hover .arrow { transform: translateX(4px); }
      .cta-aside {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.74rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* Colophon */
      .colophon {
        margin: clamp(5rem, 8vw, 7rem) 0 0;
        padding-top: 2rem;
        border-top: 3px double var(--rule);
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        line-height: 1.7;
        color: var(--muted);
        text-transform: uppercase;
      }
      .colophon p { margin: 0 0 0.5rem; max-width: 50ch; }
      .colophon strong { color: var(--ink); font-weight: 500; }

      /* Stagger reveal */
      .reveal {
        opacity: 0;
        transform: translateY(8px);
        animation: rise 800ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
      }
      .reveal:nth-child(1) { animation-delay: 60ms; }
      .reveal:nth-child(2) { animation-delay: 140ms; }
      .reveal:nth-child(3) { animation-delay: 220ms; }
      .reveal:nth-child(4) { animation-delay: 300ms; }
      .reveal:nth-child(5) { animation-delay: 380ms; }
      .reveal:nth-child(6) { animation-delay: 460ms; }

      @keyframes rise {
        to { opacity: 1; transform: translateY(0); }
      }

      @media (max-width: 720px) {
        .plate, section.spread {
          grid-template-columns: 1fr;
        }
        .margin, .plate-meta {
          border-top: none;
          padding-top: 0;
        }
        .register li {
          grid-template-columns: minmax(0, 5ch) 1fr;
        }
        .reg-plate { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="running-head">
      <span>ESPG · Direction A · Editorial Field Notebook</span>
      <a href={url('/previews')}>← all directions</a>
    </div>

    <article class="page">
      <header class="masthead">
        <p class="eyebrow reveal"><span>The Earth Sciences Postgraduate Group</span></p>
        <h1 class="title reveal">
          A society <span class="amp">&amp;</span> a conference, in stone <span class="amp">&amp;</span> ink.
        </h1>
        <p class="lede reveal">
          A student-run community at the University of Melbourne for postgraduates working across
          geology, geophysics, atmospheric and environmental sciences. We run social events,
          fieldwork, and an annual conference for early-career researchers — a <em>low-stakes,
          supportive venue</em> for work in progress.
        </p>
        <nav class="nav reveal">
          <a href="#about">About</a>
          <span class="sep">·</span>
          <a href="#events">Events</a>
          <span class="sep">·</span>
          <a href="#conference">Conference</a>
          <span class="sep">·</span>
          <a href="#committee">Committee</a>
          <span class="sep">·</span>
          <a href="#join">Become a member</a>
        </nav>
      </header>

      <figure class="plate">
        <div class="plate-meta">
          <span class="num">Pl. I.</span>
          The site<br />of the<br />society
          <br />—<br />
          Parkville<br />campus<br />Melbourne<br />37°47′S
        </div>
        <div>
          <div class="plate-figure" aria-hidden="true"></div>
          <p class="plate-caption">
            <strong>Plate I.</strong> A contour rendering of the Parkville site, after the
            university survey of 2024. The Earth Sciences Postgraduate Group is housed within the
            School of Geography, Earth and Atmospheric Sciences.
          </p>
        </div>
      </figure>

      <section class="spread" id="about">
        <aside class="margin">
          <span class="num">§ 1.</span>
          Purpose<br />&amp;<br />character<br />of the<br />society
        </aside>
        <div class="body">
          <h2>What the society <em>is</em>, and what it is for.</h2>
          <p class="dropcap">
            ESPG exists to build community across research groups, to run social and academic
            events, and to give postgraduates a voice in school-level decisions. Membership is
            free for any postgraduate enrolled in the School of Geography, Earth and Atmospheric
            Sciences. We are affiliated with the UMSU Graduate Student Association.
          </p>
          <p>
            The committee turns over annually. The society persists. This is — in its quiet way —
            the whole point.
          </p>
        </div>
      </section>

      <div class="ornament" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
          <circle cx="12" cy="12" r="3" />
          <circle cx="12" cy="12" r="7" />
          <circle cx="12" cy="12" r="11" />
        </svg>
      </div>

      <section class="spread" id="events">
        <aside class="margin">
          <span class="num">§ 2.</span>
          Register<br />of<br />upcoming<br />events
          <br />—<br />
          MMXXVI
        </aside>
        <div class="body">
          <h2>Upcoming <em>events</em>.</h2>
          <ol class="register">
            {
              events.map((e) => (
                <li>
                  <span class="reg-day">{e.day}</span>
                  <div class="reg-mid">
                    <h3>{e.title}</h3>
                    <p>{e.detail}</p>
                    <span class="reg-where">{e.location}</span>
                  </div>
                  <span class="reg-plate">
                    Pl. {e.plate}
                    <span class="my">{e.month} · {e.year}</span>
                  </span>
                </li>
              ))
            }
          </ol>
          <div class="cta-row">
            <a class="cta" href="#all-events">
              View full register <span class="arrow">→</span>
            </a>
            <span class="cta-aside">Six events in the past twelve months · twenty-two members in the year prior</span>
          </div>
        </div>
      </section>

      <section class="spread" id="conference">
        <aside class="margin">
          <span class="num">§ 3.</span>
          Annual<br />conference
          <br />—<br />
          October<br />2026
        </aside>
        <div class="body">
          <h2>The annual <em>postgraduate conference</em>.</h2>
          <p>
            Each year ESPG hosts a postgraduate-led conference: three days of HDR-led talks
            alongside invited keynotes from across the earth sciences. The conference is a
            supportive venue for students to present work-in-progress, get feedback from peers,
            and meet researchers from outside their immediate group.
          </p>

          <div class="pull">
            <blockquote>
              A low-stakes, supportive venue for early-career researchers to present
              work-in-progress.
            </blockquote>
            <cite>— ESPG conference brief, 2026</cite>
          </div>

          <p>
            Registration opens in August. The call for abstracts goes out at the same time;
            members are notified by email.
          </p>
          <div class="cta-row">
            <a class="cta" href="#conference">
              Conference details <span class="arrow">→</span>
            </a>
            <span class="cta-aside">18–20 Oct 2026 · Parkville · theme to be confirmed</span>
          </div>
        </div>
      </section>

      <section class="spread" id="committee">
        <aside class="margin">
          <span class="num">§ 4.</span>
          The<br />committee
          <br />—<br />
          2026
        </aside>
        <div class="body">
          <h2>The <em>committee</em>.</h2>
          <p>
            Six elected roles, voted at the AGM each March. All committee members are current
            postgraduates in SGEAS.
          </p>
          <ul class="committee">
            {
              committee.map((c) => (
                <li>
                  <span class="role">{c.name}</span>
                  <span class="desc">{c.detail}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="spread" id="join">
        <aside class="margin">
          <span class="num">§ 5.</span>
          Membership
          <br />—<br />
          Free<br />to all<br />SGEAS<br />postgrads
        </aside>
        <div class="body">
