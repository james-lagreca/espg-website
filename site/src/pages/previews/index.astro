---
import { url } from '../../lib/url';

const directions = [
  {
    slug: 'field-notebook',
    letter: 'A',
    title: 'Editorial Field Notebook',
    blurb:
      'Warm cream paper, ink and ochre. All-serif typography with optical sizing. Strict marginalia grid. Reads like an academic monograph or a USGS Professional Paper.',
    feel: 'Refined · Academic · Warm',
  },
  {
    slug: 'stratigraphic',
    letter: 'B',
    title: 'Stratigraphic Modern',
    blurb:
      'Dark charcoal with copper accent. Bricolage Grotesque display, sharp grotesque body. Horizontal banded layout evoking strata; contour-line atmosphere.',
    feel: 'Confident · Structural · Contemporary',
  },
  {
    slug: 'brutalist',
    letter: 'C',
    title: 'Brutalist Academic',
    blurb:
      'All-monospace, hard grid, safety-orange. Section numbering, ASCII rules, tabular events. Reads like arxiv.org built by a Bauhaus designer.',
    feel: 'Raw · Precise · Intellectual',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ESPG · Design directions</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,0..100&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #f5f3ee;
        --ink: #161616;
        --muted: #6e6a62;
        --line: #d6d2c8;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: 'Fraunces', Georgia, serif;
        font-variation-settings: 'opsz' 18, 'SOFT' 30, 'wght' 380;
        font-size: 17px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      .wrap {
        max-width: 76rem;
        margin: 0 auto;
        padding: clamp(2rem, 5vw, 5rem) clamp(1.25rem, 4vw, 3rem);
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 2rem;
        margin-bottom: clamp(3rem, 6vw, 5rem);
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--line);
      }
      h1 {
        font-variation-settings: 'opsz' 144, 'SOFT' 0, 'wght' 420;
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        line-height: 1;
        letter-spacing: -0.02em;
        margin: 0;
      }
      .meta {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .meta a { color: var(--muted); }
      .lede {
        font-variation-settings: 'opsz' 36, 'SOFT' 50, 'wght' 350;
        font-size: clamp(1.15rem, 1.8vw, 1.45rem);
        max-width: 50ch;
        line-height: 1.35;
        margin: 0 0 clamp(3rem, 5vw, 5rem);
        color: #2a2a2a;
      }
      em {
        font-style: italic;
        font-variation-settings: 'opsz' 36, 'SOFT' 100, 'wght' 350;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
        gap: clamp(1rem, 2vw, 1.5rem);
      }
      a.card {
        display: block;
        position: relative;
        padding: clamp(1.5rem, 3vw, 2.5rem);
        background: #fbfaf6;
        border: 1px solid var(--line);
        text-decoration: none;
        color: var(--ink);
        transition: border-color 200ms ease, transform 200ms ease;
        overflow: hidden;
      }
      a.card:hover {
        border-color: var(--ink);
        transform: translateY(-2px);
      }
      .card-letter {
        position: absolute;
        top: 0;
        right: 0;
        font-variation-settings: 'opsz' 144, 'SOFT' 0, 'wght' 300;
        font-size: clamp(6rem, 12vw, 10rem);
        line-height: 1;
        color: var(--line);
        padding: 0.5rem 0.75rem 0;
        pointer-events: none;
        user-select: none;
      }
      .card h2 {
        position: relative;
        margin: 0 0 0.75rem;
        font-variation-settings: 'opsz' 48, 'SOFT' 30, 'wght' 400;
        font-size: clamp(1.5rem, 2.5vw, 2rem);
        line-height: 1.05;
        letter-spacing: -0.01em;
        max-width: 18ch;
      }
      .card p {
        position: relative;
        margin: 0 0 1.25rem;
        max-width: 32ch;
        font-size: 0.98rem;
        line-height: 1.45;
      }
      .feel {
        position: relative;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .footnote {
        margin-top: clamp(4rem, 8vw, 7rem);
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        color: var(--muted);
        max-width: 55ch;
        line-height: 1.6;
      }
      .footnote a { color: var(--ink); }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <span class="meta">ESPG · Design directions · 2026</span>
        <a class="meta" href={url('/')}>← back to current site</a>
      </header>

      <h1>Three<br />directions.</h1>
      <p class="lede">
        Each preview is a complete homepage in a fully-committed visual language — not a swatch.
        Browse them on phone and laptop, sit with each one for a minute, then pick the one that
        feels like <em>ESPG</em>.
      </p>

      <div class="grid">
        {
          directions.map((d) => (
            <a class="card" href={url(`/previews/${d.slug}`)}>
              <span class="card-letter">{d.letter}</span>
              <h2>{d.title}</h2>
              <p>{d.blurb}</p>
              <span class="feel">{d.feel}</span>
            </a>
          ))
        }
      </div>

      <p class="footnote">
        Note · these preview routes will be removed once a direction is chosen. The chosen
        typography, palette and component vocabulary will then be applied across the live site.
      </p>
    </div>
  </body>
</html>
