---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

const now = new Date();
const all = (await getCollection('events', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const upcoming = all
  .filter((e) => (e.data.endDate ?? e.data.date) >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const past = all.filter((e) => (e.data.endDate ?? e.data.date) < now);

const dateFmt = new Intl.DateTimeFormat('en-AU', {
  weekday: 'short',
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<BaseLayout
  title="Events"
  description="Upcoming and past events run by the ESPG, including social events, field trips, and the annual postgraduate conference."
>
  <p class="eyebrow">Events</p>
  <h1>Events</h1>

  <section>
    <h2>Upcoming</h2>
    {
      upcoming.length === 0 ? (
        <p class="muted">No upcoming events scheduled. Check back soon.</p>
      ) : (
        <ul class="event-list">
          {upcoming.map((e) => (
            <li>
              <a href={url(`/events/${e.id}`)}>
                <time datetime={e.data.date.toISOString()}>{dateFmt.format(e.data.date)}</time>
                <div>
                  <span class="event-title">{e.data.title}</span>
                  <span class="muted location">{e.data.location}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    past.length > 0 && (
      <section>
        <h2>Past events</h2>
        <ul class="event-list">
          {past.map((e) => (
            <li>
              <a href={url(`/events/${e.id}`)}>
                <time datetime={e.data.date.toISOString()}>{dateFmt.format(e.data.date)}</time>
                <div>
                  <span class="event-title">{e.data.title}</span>
                  <span class="muted location">{e.data.location}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .event-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5);
    border-top: 1px solid var(--color-rule);
  }
  .event-list li {
    border-bottom: 1px solid var(--color-rule);
  }
  .event-list a {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    text-decoration: none;
    color: inherit;
    align-items: baseline;
  }
  .event-list a:hover .event-title {
    text-decoration: underline;
  }
  .event-list time {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    font-size: 0.92rem;
  }
  .event-title {
    font-weight: 500;
    margin-right: var(--space-3);
  }
  .location {
    font-size: 0.9rem;
  }
  @media (max-width: 600px) {
    .event-list a {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
