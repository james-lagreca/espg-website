---
import { getCollection, render } from 'astro:content';
import SocietyLayout from '../../layouts/SocietyLayout.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const entries = await getCollection('events');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const dateFmt = new Intl.DateTimeFormat('en-AU', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const timeFmt = new Intl.DateTimeFormat('en-AU', {
  hour: 'numeric',
  minute: '2-digit',
});
---

<SocietyLayout title={entry.data.title} description={entry.data.description}>
  <p class="back"><a href={url('/events')}>← Events register</a></p>

  <article class="event">
    <p class="sect-tag">Event</p>
    <h1>{entry.data.title}</h1>

    <dl class="meta">
      <div>
        <dt>Date</dt>
        <dd>
          <time datetime={entry.data.date.toISOString()}>
            {dateFmt.format(entry.data.date)}
          </time>
          <span class="time">{timeFmt.format(entry.data.date)}</span>
        </dd>
      </div>
      <div>
        <dt>Location</dt>
        <dd>{entry.data.location}</dd>
      </div>
    </dl>

    <div class="prose">
      <p class="lede">{entry.data.description}</p>
      <Content />
      {
        entry.data.link && (
          <p>
            <a class="link-out" href={entry.data.link}>More information →</a>
          </p>
        )
      }
    </div>
  </article>
</SocietyLayout>

<style>
  .back {
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .back a { color: var(--bone-soft); }
  .back a:hover { color: var(--copper); }

  .event h1 {
    margin: 0.5rem 0 1.5rem;
    max-width: 24ch;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin: 0 0 2rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .meta dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bone-soft);
    margin: 0 0 0.3rem;
  }
  .meta dd {
    margin: 0;
    font-size: 1.05rem;
  }
  .meta .time {
    display: inline-block;
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--copper);
  }

  .prose .lede {
    font-size: 1.2rem;
    line-height: 1.4;
    color: var(--bone);
  }
  .prose p { max-width: 60ch; }
  .link-out { color: var(--copper); border-bottom: 1px solid currentColor; }
  .link-out:hover { color: var(--copper-bright); }
</style>
