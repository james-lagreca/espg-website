---
import { getCollection } from 'astro:content';
import SocietyLayout from '../layouts/SocietyLayout.astro';
import SocietyMasthead from '../components/society/SocietyMasthead.astro';
import { url } from '../lib/url';

const now = new Date();

const allEvents = (await getCollection('events', ({ data }) => !data.draft)).filter(
  (e) => (e.data.endDate ?? e.data.date) >= now,
).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const featured = allEvents.slice(0, 3).map((e) => ({
  id: e.id,
  date: e.data.date,
  title: e.data.title,
  location: e.data.location,
}));

const register = allEvents.slice(0, 6);
const dayFmt = new Intl.DateTimeFormat('en-AU', { day: '2-digit', month: 'short' });
const wdFmt = new Intl.DateTimeFormat('en-AU', { weekday: 'short' });

const CURRENT_YEAR = 2026;
const committeeAll = (await getCollection('committee')).sort((a, b) => a.data.order - b.data.order);
const currentCommittee = committeeAll.filter((c) => c.data.year === CURRENT_YEAR);
const pastCommittee = committeeAll
  .filter((c) => c.data.year !== CURRENT_YEAR)
  .reduce<{ year: number; entries: typeof committeeAll }[]>((acc, c) => {
    const bucket = acc.find((g) => g.year === c.data.year);
    if (bucket) bucket.entries.push(c);
    else acc.push({ year: c.data.year, entries: [c] });
    return acc;
  }, [])
  .sort((a, b) => b.year - a.year);
const mostRecentPast = pastCommittee[0];
---

<SocietyLayout
  title="ESPG — Earth Sciences Postgraduate Group"
  description="The Earth Sciences Postgraduate Group is a student-run society at the University of Melbourne for postgraduates working across geology, geophysics, atmospheric and environmental sciences."
>
  <SocietyMasthead featured={featured} />

  <!-- REGISTER -->
  <section id="events" class="section">
    <p class="sect-tag">Register</p>
    <h2>Upcoming events, <em>tabulated.</em></h2>
    <p class="muted">The six closest dates. Full archive on the <a href={url('/events')}>events page</a>.</p>

    {
      register.length === 0 ? (
        <p class="muted">No upcoming events scheduled — check back soon.</p>
      ) : (
        <ol class="register">
          {register.map((e) => {
            const [day, mo] = dayFmt.format(e.data.date).split(' ');
            const wd = wdFmt.format(e.data.date);
            return (
              <li>
                <a href={url(`/events/${e.id}`)}>
                  <span class="reg-date">
                    {day}<span class="mo">{mo} '{e.data.date.getFullYear().toString().slice(2)}</span>
                  </span>
                  <div class="reg-mid">
                    <h3>{e.data.title}</h3>
                    <span class="loc">{wd} · {e.data.location}</span>
                  </div>
                  <span class="arrow-mark" aria-hidden="true">→</span>
                </a>
              </li>
            );
          })}
        </ol>
      )
    }
    <div class="cta-row">
      <a href={url('/events')} class="cta cta--ghost">Full register <span class="arrow">→</span></a>
      <span class="cta-aside">Subscribe to event emails when you join.</span>
    </div>
  </section>

  <!-- MEMBERSHIP -->
  <section id="membership" class="section section--warm">
    <p class="sect-tag">Membership</p>
    <h2>Free. <em>For any postgrad</em> in the school.</h2>
    <div class="join-grid">
      <div>
        <p>
          Membership takes about a minute to sign up. There are no fees, no formal commitments,
          and you can stay on the mailing list for as long as you're a postgraduate in SGEAS.
        </p>
        <ul class="join-pills">
          <li><span class="ix">01</span><span class="it">Event emails — BBQs, field trips, pub nights, conferences.</span></li>
          <li><span class="ix">02</span><span class="it">Conference call for abstracts each August.</span></li>
          <li><span class="ix">03</span><span class="it">School-level representation through the HDR rep.</span></li>
          <li><span class="ix">04</span><span class="it">Travel and conference bursaries (where budget allows).</span></li>
          <li><span class="ix">05</span><span class="it">Occasional opportunities from outside the school.</span></li>
        </ul>
        <div class="cta-row">
          <a href={url('/membership')} class="cta">Join the society <span class="arrow">→</span></a>
          <a href={url('/membership')} class="cta cta--ghost">Mailing list only</a>
        </div>
      </div>
      <aside class="join-card">
        <dl class="join-stat">
          <dt>Cost</dt><dd><strong>Free</strong> for SGEAS HDRs</dd>
          <dt>Conference</dt><dd><strong>Annual</strong> postgraduate-led</dd>
          <dt>Affiliation</dt><dd>UMSU Graduate Student Association</dd>
          <dt>School</dt><dd>Geography, Earth &amp; Atmospheric Sciences</dd>
        </dl>
      </aside>
    </div>
  </section>

  <!-- CONFERENCE teaser -->
  <section id="conference-teaser" class="section">
    <p class="sect-tag">Conference</p>
    <div class="conf-grid">
      <div>
        <h2>An annual <em>postgraduate</em> conference, in October.</h2>
        <p>
          Three days of HDR-led talks alongside invited keynotes from across the earth sciences.
          The conference is a supportive venue for students to present work-in-progress, get
          feedback from peers, and meet researchers from outside their immediate group.
        </p>
        <p class="muted">Registration opens August. Call for abstracts the same week.</p>
        <a href={url('/conference')} class="cta">Conference details <span class="arrow">→</span></a>
      </div>
      <aside class="conf-card">
        <dl>
          <dt>Dates</dt><dd><strong>18–20 Oct 2026</strong></dd>
          <dt>Location</dt><dd>University of Melbourne, Parkville</dd>
          <dt>Theme</dt><dd>TBA</dd>
          <dt>Keynote</dt><dd>To be announced</dd>
          <dt>Format</dt><dd>Talks · posters · lightning</dd>
          <dt>Abstracts</dt><dd>Open Aug · close Sep</dd>
        </dl>
      </aside>
    </div>
  </section>

  <!-- COMMITTEE -->
  <section id="committee" class="section section--cool">
    <p class="sect-tag">Committee {CURRENT_YEAR}</p>
    <h2>Elected at the AGM, <em>each March.</em></h2>
    {
      currentCommittee.length > 0 ? (
        <>
          <p class="muted">All current postgraduates in SGEAS.</p>
          <ul class="committee-grid">
            {currentCommittee.map((m) => (
              <li>
                <span class="role">{m.data.role}</span>
                <span class="desc">{m.data.name}</span>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <>
          <p class="muted">
            The {CURRENT_YEAR} committee will be elected at the AGM in March. Interested in
            running?{' '}
            <a href={url('/about')}>See the role descriptions on the About page.</a>
          </p>
          {mostRecentPast && (
            <>
              <p class="muted" style="margin-top: 1.5rem;">
                Most recent committee ({mostRecentPast.year}):
              </p>
              <ul class="committee-grid">
                {mostRecentPast.entries.map((m) => (
                  <li>
                    <span class="role">{m.data.role}</span>
                    <span class="desc">{m.data.name}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
        </>
      )
    }
    <p style="margin-top: 1.25rem;"><a href={url('/about')}>More about ESPG →</a></p>
  </section>
</SocietyLayout>

<style>
  .section {
    position: relative;
    padding: clamp(3rem, 6vw, 5rem) 0;
    border-bottom: 1px solid var(--rule);
  }
  .section--warm {
    background: var(--bg-warm);
    margin: 0 calc(-1 * clamp(1.5rem, 4vw, 3rem));
    padding-left: clamp(1.5rem, 4vw, 3rem);
    padding-right: clamp(1.5rem, 4vw, 3rem);
  }
  .section--cool {
    background: var(--bg-cool);
    margin: 0 calc(-1 * clamp(1.5rem, 4vw, 3rem));
    padding-left: clamp(1.5rem, 4vw, 3rem);
    padding-right: clamp(1.5rem, 4vw, 3rem);
  }

  /* Register */
  .register {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .register li {
    border-bottom: 1px solid var(--rule);
  }
  .register a {
    display: grid;
    grid-template-columns: minmax(0, 4.5rem) minmax(0, 1fr) minmax(0, auto);
    gap: clamp(1rem, 2vw, 2rem);
    padding: 1.25rem 0;
    text-decoration: none;
    color: inherit;
    align-items: center;
    transition: background 160ms;
  }
  .register a:hover {
    background: rgba(208, 118, 54, 0.04);
    color: inherit;
  }
  .register a:hover h3 { color: var(--copper); }
  .reg-date {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 60, 'wdth' 95, 'wght' 600;
    font-size: clamp(2.2rem, 4vw, 3rem);
    line-height: 0.85;
    letter-spacing: -0.025em;
    color: var(--bone);
  }
  .reg-date .mo {
    display: block;
    font-family: var(--font-mono);
    font-variation-settings: normal;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--copper);
    margin-top: 0.35rem;
    font-weight: 500;
  }
  .reg-mid h3 {
    margin: 0 0 0.2rem;
    transition: color 160ms;
  }
  .reg-mid .loc {
    font-size: 0.86rem;
    color: var(--bone-soft);
  }
  .arrow-mark {
    font-family: var(--font-mono);
    color: var(--bone-soft);
    font-size: 1.1rem;
  }
  .register a:hover .arrow-mark { color: var(--copper); }
  @media (max-width: 720px) {
    .register a { grid-template-columns: minmax(0, 4.5rem) 1fr; row-gap: 0.5rem; }
    .arrow-mark { display: none; }
  }

  .cta-row {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
  }

  /* Join */
  .join-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    margin-top: 0.75rem;
  }
  @media (max-width: 720px) { .join-grid { grid-template-columns: 1fr; } }

  .join-pills {
    list-style: none;
    margin: 1.25rem 0 1.75rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .join-pills li {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: 0.85rem;
    align-items: baseline;
  }
  .join-pills .ix {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--copper);
    letter-spacing: 0.06em;
    font-weight: 500;
  }
  .join-pills .it { font-size: 0.98rem; line-height: 1.4; }

  .join-card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--rule-warm);
    background: linear-gradient(180deg, rgba(208, 118, 54, 0.08), transparent 75%);
    position: relative;
  }
  .join-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--copper);
  }
  .join-stat {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: 0.6rem 1rem;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
  }
  .join-stat dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bone-soft);
    align-self: center;
    white-space: nowrap;
  }
  .join-stat dd { margin: 0; }
  .join-stat dd strong {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 24, 'wdth' 100, 'wght' 500;
    font-size: 1.05rem;
    color: var(--copper);
  }

  /* Conference */
  .conf-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 720px) { .conf-grid { grid-template-columns: 1fr; } }
  .conf-card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--rule-warm);
    background: var(--bg-card);
  }
  .conf-card dl {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: 0.7rem 1.5rem;
    margin: 0;
    font-size: 0.92rem;
  }
  .conf-card dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bone-soft);
    align-self: center;
    white-space: nowrap;
  }
  .conf-card dd { margin: 0; }
  .conf-card dd strong {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 24, 'wdth' 100, 'wght' 500;
    font-size: 1.05rem;
    color: var(--copper);
  }

  /* Committee */
  .committee-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    margin-top: 1.5rem;
  }
  .committee-grid li {
    list-style: none;
    background: var(--bg);
    padding: 1.1rem 1.2rem;
  }
  .committee-grid .role {
    display: block;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 24, 'wdth' 100, 'wght' 500;
    font-size: 1rem;
    letter-spacing: -0.005em;
    margin-bottom: 0.15rem;
  }
  .committee-grid .desc {
    font-size: 0.83rem;
    color: var(--bone-soft);
  }
</style>
