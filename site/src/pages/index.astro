---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const now = new Date();
const events = (await getCollection('events', ({ data }) => !data.draft))
  .filter((e) => (e.data.endDate ?? e.data.date) >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat('en-AU', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<BaseLayout
  title="ESPG — Earth Sciences Postgraduate Group"
  description="The Earth Sciences Postgraduate Group is a student-run society at the University of Melbourne for postgraduates working across geology, geophysics, atmospheric and environmental sciences."
>
  <section class="hero">
    <p class="eyebrow">University of Melbourne</p>
    <h1>Earth Sciences Postgraduate Group</h1>
    <p class="lede">
      A student-run community for postgraduates in the School of Geography, Earth and Atmospheric
      Sciences. We run social events, fieldwork, and an annual conference for early-career
      researchers.
    </p>
    <p>
      <a href={url('/membership')} class="cta">Become a member</a>
    </p>
  </section>

  <hr />

  <section>
    <h2>Upcoming events</h2>
    {
      events.length === 0 ? (
        <p class="muted">No upcoming events scheduled — check back soon.</p>
      ) : (
        <ul class="event-list">
          {events.map((e) => (
            <li>
              <a href={url(`/events/${e.id}`)}>
                <time datetime={e.data.date.toISOString()}>{dateFmt.format(e.data.date)}</time>
                <span class="event-title">{e.data.title}</span>
                <span class="muted">{e.data.location}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <p><a href={url('/events')}>All events →</a></p>
  </section>

  <hr />

  <section class="prose">
    <h2>Annual conference</h2>
    <p>
      Each year ESPG hosts a postgraduate-led conference: a low-stakes, supportive venue for HDR
      students to present work-in-progress alongside invited keynote speakers from across the
      earth sciences.
    </p>
    <p>
      <a href={url('/conference')}>Conference details →</a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-4) 0 var(--space-3);
  }
  .lede {
    font-size: 1.15rem;
    max-width: var(--measure);
  }
  .cta {
    display: inline-block;
    margin-top: var(--space-2);
    padding: 0.7rem 1.2rem;
    background: var(--color-accent);
    color: #fff;
    border-radius: 2px;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .cta:hover {
    background: var(--color-accent-hover);
    color: #fff;
  }
  .event-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
    border-top: 1px solid var(--color-rule);
  }
  .event-list li {
    border-bottom: 1px solid var(--color-rule);
  }
  .event-list a {
    display: grid;
    grid-template-columns: 9rem 1fr auto;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    text-decoration: none;
    color: inherit;
    align-items: baseline;
  }
  .event-list a:hover .event-title {
    text-decoration: underline;
  }
  .event-list time {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    font-size: 0.92rem;
  }
  .event-title {
    font-weight: 500;
  }
  @media (max-width: 600px) {
    .event-list a {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
