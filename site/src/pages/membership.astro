---
import SocietyLayout from '../layouts/SocietyLayout.astro';
import PageHeader from '../components/society/PageHeader.astro';

// Google Form link (full-page, not embedded). Clicking the CTA opens this in a new tab.
const formUrl =
  'https://docs.google.com/forms/d/e/1FAIpQLScVkYv6kWXxr8R0CGh1MuKfX7qMSuNhs_nvjq2OJ6Xya4wwKA/viewform';
---

<SocietyLayout
  title="Membership"
  description="Join the Earth Sciences Postgraduate Group. Membership is free for SGEAS postgraduate students at the University of Melbourne."
>
  <PageHeader
    eyebrow="Membership"
    title="Free. For any postgrad in the school."
    lede="Sign-up takes about a minute. You'll be added to the mailing list for event announcements and the annual conference call for abstracts."
  />

  <div class="join-grid">
    <div>
      <h2>What you get</h2>
      <ul class="join-pills">
        <li><span class="ix">01</span><span class="it">Event emails — BBQs, field trips, pub nights, conferences.</span></li>
        <li><span class="ix">02</span><span class="it">Conference call for abstracts each August.</span></li>
        <li><span class="ix">03</span><span class="it">School-level representation through the HDR rep.</span></li>
        <li><span class="ix">04</span><span class="it">Travel and conference bursaries (where budget allows).</span></li>
        <li><span class="ix">05</span><span class="it">Occasional opportunities from outside the school.</span></li>
      </ul>

      <h2>Eligibility</h2>
      <p>
        Any Masters or PhD student currently enrolled in the School of Geography, Earth and
        Atmospheric Sciences (SGEAS) at the University of Melbourne. There is no fee. You can
        leave the mailing list at any time.
      </p>
    </div>

    <aside class="form-card">
      <p class="sect-tag">Sign-up</p>
      <h2 class="form-title">Open the membership form.</h2>
      <p class="form-lede">
        Hosted on Google Forms. Takes about a minute. You'll be asked your
        name, student email, year of study, and primary research area.
      </p>

      <ul class="form-preview">
        <li><span class="dot"></span> Name &amp; preferred pronouns</li>
        <li><span class="dot"></span> Student email (unimelb)</li>
        <li><span class="dot"></span> Degree, year, supervisor</li>
        <li><span class="dot"></span> Research area</li>
        <li><span class="dot"></span> Whether you'd like to help on committee</li>
      </ul>

      <a
        href={formUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="form-cta"
      >
        Open sign-up form
        <svg class="arrow" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>

      <p class="form-note">
        Opens in a new tab. Already a member? You can re-submit the form to
        update your details — your previous record will be replaced.
      </p>
    </aside>
  </div>
</SocietyLayout>

<style>
  .join-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  @media (max-width: 860px) {
    .join-grid { grid-template-columns: 1fr; }
  }
  h2 {
    margin: 0 0 1rem;
  }
  .join-grid > div > h2:not(:first-child) {
    margin-top: 2.5rem;
  }

  .join-pills {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .join-pills li {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: 0.85rem;
    align-items: baseline;
  }
  .join-pills .ix {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--copper);
    letter-spacing: 0.06em;
    font-weight: 500;
  }
  .join-pills .it { font-size: 0.98rem; line-height: 1.4; }

  /* --- Form card --- */
  .form-card {
    position: relative;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border: 1px solid var(--rule-warm);
    background:
      linear-gradient(180deg, rgba(208, 118, 54, 0.07), transparent 70%),
      var(--bg-card);
  }
  .form-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--copper);
  }

  .form-title {
    margin: 0.6rem 0 0.6rem;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 18ch;
  }
  .form-lede {
    margin: 0 0 1.5rem;
    color: var(--bone-soft);
    font-size: 0.96rem;
    line-height: 1.45;
    max-width: 40ch;
  }
  .form-preview {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: grid;
    gap: 0.4rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.25rem;
  }
  .form-preview li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--bone-soft);
  }
  .form-preview .dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--copper);
    flex: 0 0 5px;
    opacity: 0.7;
  }

  .form-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 1rem 1.4rem;
    background: var(--copper);
    color: #18191a;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--copper);
    transition: background 200ms ease, transform 200ms ease, box-shadow 200ms ease;
    box-shadow: 0 6px 22px rgba(208, 118, 54, 0.15);
  }
  .form-cta:hover {
    background: var(--copper-bright);
    border-color: var(--copper-bright);
    color: #18191a;
    transform: translateY(-1px);
    box-shadow: 0 10px 28px rgba(208, 118, 54, 0.28);
  }
  .form-cta:hover .arrow { transform: translateX(4px); }
  .form-cta .arrow { transition: transform 200ms ease; }

  .form-note {
    margin: 1.25rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
    max-width: 38ch;
  }
</style>
