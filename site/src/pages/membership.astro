---
import SocietyLayout from '../layouts/SocietyLayout.astro';
import PageHeader from '../components/society/PageHeader.astro';

// TODO Phase 5: replace with real Google Form embed URL
const formEmbedUrl: string | null = null;
---

<SocietyLayout
  title="Membership"
  description="Join the Earth Sciences Postgraduate Group. Membership is free for SGEAS postgraduate students at the University of Melbourne."
>
  <PageHeader
    eyebrow="Membership"
    title="Free. For any postgrad in the school."
    lede="Sign-up takes about a minute. You'll be added to the mailing list for event announcements and the annual conference call for abstracts."
  />

  <div class="join-grid">
    <div>
      <h2>What you get</h2>
      <ul class="join-pills">
        <li><span class="ix">01</span><span class="it">Event emails — BBQs, field trips, pub nights, conferences.</span></li>
        <li><span class="ix">02</span><span class="it">Conference call for abstracts each August.</span></li>
        <li><span class="ix">03</span><span class="it">School-level representation through the HDR rep.</span></li>
        <li><span class="ix">04</span><span class="it">Travel and conference bursaries (where budget allows).</span></li>
        <li><span class="ix">05</span><span class="it">Occasional opportunities from outside the school.</span></li>
      </ul>

      <h2>Eligibility</h2>
      <p>
        Any Masters or PhD student currently enrolled in the School of Geography, Earth and
        Atmospheric Sciences (SGEAS) at the University of Melbourne. There is no fee. You can
        leave the mailing list at any time.
      </p>
    </div>

    <aside class="form-side">
      <p class="sect-tag">Sign-up</p>
      {
        formEmbedUrl ? (
          <iframe
            src={formEmbedUrl}
            width="100%"
            height="900"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            title="ESPG membership form"
          >
            Loading…
          </iframe>
        ) : (
          <div class="placeholder">
            <p>
              <strong>Form embed pending.</strong>
            </p>
            <p>
              The Google Form will be embedded here during content migration. In the meantime,
              email the secretary to be added to the mailing list manually.
            </p>
          </div>
        )
      }
    </aside>
  </div>
</SocietyLayout>

<style>
  .join-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  @media (max-width: 860px) {
    .join-grid { grid-template-columns: 1fr; }
  }
  h2 {
    margin: 0 0 1rem;
  }
  h2 + * { margin-top: 0; }
  .join-grid > div > h2:not(:first-child) {
    margin-top: 2.5rem;
  }

  .join-pills {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .join-pills li {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: 0.85rem;
    align-items: baseline;
  }
  .join-pills .ix {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--copper);
    letter-spacing: 0.06em;
    font-weight: 500;
  }
  .join-pills .it { font-size: 0.98rem; line-height: 1.4; }

  .form-side {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--rule-warm);
    background: var(--bg-card);
    position: relative;
  }
  .form-side::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--copper);
  }
  .placeholder {
    border: 1px dashed var(--rule-warm);
    padding: 1.5rem;
    margin-top: 1rem;
    background: rgba(208, 118, 54, 0.03);
  }
  .placeholder p { margin: 0 0 0.5rem; }
  .placeholder p:last-child { margin: 0; }
  .placeholder strong { color: var(--copper); }
  iframe {
    border: 1px solid var(--rule-warm);
    background: var(--bg);
    margin-top: 1rem;
  }
</style>
