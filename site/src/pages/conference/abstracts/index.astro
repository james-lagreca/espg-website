---
import { getCollection } from 'astro:content';
import ConferenceLayout from '../../../layouts/ConferenceLayout.astro';
import { url } from '../../../lib/url';

const abstracts = (await getCollection('abstracts')).sort((a, b) =>
  a.data.presenter.localeCompare(b.data.presenter),
);
const sessions = [...new Set(abstracts.map((a) => a.data.session).filter(Boolean))] as string[];
---

<ConferenceLayout
  title="Abstracts"
  description="Accepted abstracts for the ESPG Annual Postgraduate Conference."
>
  <p class="eyebrow">Abstracts</p>
  <h1>Abstracts.</h1>
  <p class="lede">{abstracts.length} accepted abstracts, organised by session.</p>

  {
    abstracts.length === 0 ? (
      <p class="muted">Accepted abstracts will be published here after the review process closes.</p>
    ) : sessions.length > 0 ? (
      sessions.map((s) => (
        <section>
          <h2>{s}</h2>
          <ul class="abstract-list">
            {abstracts
              .filter((a) => a.data.session === s)
              .map((a) => (
                <li>
                  <a href={url(`/conference/abstracts/${a.id}`)}>
                    <span class="abs-title">{a.data.title}</span>
                    <span class="muted">
                      {a.data.presenter} · {a.data.affiliation}
                    </span>
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))
    ) : (
      <ul class="abstract-list">
        {abstracts.map((a) => (
          <li>
            <a href={url(`/conference/abstracts/${a.id}`)}>
              <span class="abs-title">{a.data.title}</span>
              <span class="muted">{a.data.presenter} · {a.data.affiliation}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</ConferenceLayout>

<style>
  .abstract-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 2.5rem;
    border-top: 1px solid var(--c-rule);
  }
  .abstract-list li { border-bottom: 1px solid var(--c-rule); }
  .abstract-list a {
    display: block;
    padding: 1rem 0;
    border-bottom: none;
    color: var(--c-ink);
  }
  .abstract-list a:hover .abs-title { color: var(--c-accent); }
  .abs-title {
    display: block;
    font-family: 'Newsreader', Georgia, serif;
    font-variation-settings: 'opsz' 22;
    font-size: 1.1rem;
    font-weight: 460;
    margin-bottom: 0.25rem;
  }
</style>
