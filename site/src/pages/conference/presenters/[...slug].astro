---
import { getCollection, render } from 'astro:content';
import ConferenceLayout from '../../../layouts/ConferenceLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('presenters');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const roleLabel: Record<string, string> = {
  keynote: 'Keynote speaker',
  invited: 'Invited speaker',
  speaker: 'Speaker',
};
---

<ConferenceLayout title={entry.data.name} description={`${roleLabel[entry.data.role]} — ${entry.data.affiliation}`}>
  <p class="eyebrow">{roleLabel[entry.data.role]}</p>
  <h1>{entry.data.name}</h1>
  <p class="lede muted">{entry.data.affiliation}</p>

  <div class="prose">
    <Content />
  </div>
</ConferenceLayout>

<style>
  .prose p { font-size: 1.02rem; max-width: 62ch; }
</style>
