---
import { getCollection } from 'astro:content';
import ConferenceLayout from '../../../layouts/ConferenceLayout.astro';
import { url } from '../../../lib/url';

const all = (await getCollection('presenters')).sort((a, b) => a.data.order - b.data.order);
const keynotes = all.filter((p) => p.data.role === 'keynote');
const invited = all.filter((p) => p.data.role === 'invited');
const others = all.filter((p) => p.data.role === 'speaker');
---

<ConferenceLayout
  title="Presenters"
  description="Keynote and invited speakers at VUEESC × GESSS 2026."
>
  <p class="eyebrow">Speakers</p>
  <h1>Speakers</h1>

  {
    all.length === 0 ? (
      <div class="empty"><p>Keynote and invited speakers will be announced here as they are confirmed.</p></div>
    ) : (
      <>
        {keynotes.length > 0 && (
          <section>
            <h2>Keynote speakers</h2>
            <ul class="presenter-grid">
              {keynotes.map((p) => (
                <li>
                  <a href={url(`/conference/presenters/${p.id}`)}>
                    <h3>{p.data.name}</h3>
                    <p class="muted">{p.data.affiliation}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
        {invited.length > 0 && (
          <section>
            <h2>Invited speakers</h2>
            <ul class="presenter-grid">
              {invited.map((p) => (
                <li>
                  <a href={url(`/conference/presenters/${p.id}`)}>
                    <h3>{p.data.name}</h3>
                    <p class="muted">{p.data.affiliation}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
        {others.length > 0 && (
          <section>
            <h2>Speakers</h2>
            <ul class="presenter-grid">
              {others.map((p) => (
                <li>
                  <a href={url(`/conference/presenters/${p.id}`)}>
                    <h3>{p.data.name}</h3>
                    <p class="muted">{p.data.affiliation}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </>
    )
  }
</ConferenceLayout>

<style>
  .presenter-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .presenter-grid a {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--card);
    color: var(--ink);
  }
  .presenter-grid a:hover { border-color: var(--teal); }
  .presenter-grid h3 { margin: 0 0 0.25rem; font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; }
  .presenter-grid p { margin: 0; font-size: 0.9rem; }
</style>
