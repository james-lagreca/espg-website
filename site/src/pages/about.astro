---
import { getCollection } from 'astro:content';
import SocietyLayout from '../layouts/SocietyLayout.astro';
import PageHeader from '../components/society/PageHeader.astro';

const CURRENT_YEAR = 2026;

const committee = (await getCollection('committee')).sort(
  (a, b) => a.data.order - b.data.order,
);

const current = committee.filter((c) => c.data.year === CURRENT_YEAR);
const pastByYear = new Map<number, typeof committee>();
for (const c of committee) {
  if (c.data.year === CURRENT_YEAR) continue;
  const list = pastByYear.get(c.data.year) ?? [];
  list.push(c);
  pastByYear.set(c.data.year, list);
}
const pastYears = [...pastByYear.keys()].sort((a, b) => b - a);

// Roles we expect to fill each year, used to render placeholder cards when
// the current committee hasn't been elected yet.
const PLACEHOLDER_ROLES = ['President', 'Treasurer', 'Secretary', 'General Member'];
---

<SocietyLayout
  title="About"
  description="The Earth Sciences Postgraduate Group is a student society supporting postgraduate students and staff at the University of Melbourne."
>
  <PageHeader
    eyebrow="About"
    title="A student society for postgraduate Earth Sciences."
    lede="The ESPG is here to support postgraduate students and staff in Earth Sciences at the University of Melbourne. Climate, weather, geology and more."
  />

  <section class="block">
    <h2>Our story</h2>
    <p>
      The ESPG was established as a GSA-affiliated group to support postgraduate students in the
      School of Geography, Earth and Atmospheric Sciences (SGEAS) at the University of Melbourne.
      We exist for the community across research groups — bringing together masters and PhD
      students working on everything from active tectonics and isotope geochemistry to atmospheric
      science and palaeoclimate.
    </p>
  </section>

  <section class="block">
    <h2>Our aims</h2>
    <ul class="aims">
      <li>To provide academic support and welfare to the postgraduates of the School.</li>
      <li>To promote social interaction between all postgraduates within the School, the entire faculty and wider university community.</li>
      <li>To foster communication of research ideas and collaborations.</li>
      <li>To support the academic endeavors of postgraduate students and to act as a representative group.</li>
    </ul>
  </section>

  <section class="block">
    <h2>Committee {CURRENT_YEAR}</h2>
    {
      current.length === 0 ? (
        <>
          <p class="muted">
            The {CURRENT_YEAR} committee will be elected at the AGM in March. If you'd like to
            help run the society this year, get in touch via the contact details below.
          </p>
          <ul class="committee-grid">
            {PLACEHOLDER_ROLES.map((role) => (
              <li class="placeholder">
                <span class="role">{role}</span>
                <span class="name">To be elected</span>
                <span class="hint">AGM · March {CURRENT_YEAR}</span>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <ul class="committee-grid">
          {current.map((m) => (
            <li>
              <span class="role">{m.data.role}</span>
              <span class="name">{m.data.name}</span>
              {m.data.email && (
                <a class="email" href={`mailto:${m.data.email}`}>
                  {m.data.email}
                </a>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    pastYears.map((yr) => (
      <section class="block">
        <h2>Past committee — {yr}</h2>
        <ul class="committee-grid committee-grid--past">
          {pastByYear.get(yr)!.map((m) => (
            <li>
              <span class="role">{m.data.role}</span>
              <span class="name">{m.data.name}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="block">
    <h2>Contact &amp; affiliations</h2>
    <p>
      We're affiliated with the UMSU Graduate Student Association.
    </p>
    <dl class="contact">
      <div>
        <dt>Email</dt>
        <dd><a href="mailto:the.espg@gmail.com">the.espg@gmail.com</a></dd>
      </div>
      <div>
        <dt>Address</dt>
        <dd>
          School of Geography, Earth and Atmospheric Sciences<br />
          253–283 Elgin St, Carlton VIC 3053<br />
          The University of Melbourne
        </dd>
      </div>
      <div>
        <dt>Twitter / X</dt>
        <dd><a href="https://twitter.com/unimelbespg" target="_blank" rel="noopener noreferrer">@unimelbespg</a></dd>
      </div>
    </dl>
  </section>
</SocietyLayout>

<style>
  .block {
    padding: clamp(2rem, 4vw, 3.5rem) 0;
    border-bottom: 1px solid var(--rule);
  }
  .block:last-child { border-bottom: none; }

  .aims {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    display: grid;
    gap: 0.6rem;
    max-width: 62ch;
  }
  .aims li {
    padding-left: 1.4rem;
    position: relative;
    line-height: 1.5;
  }
  .aims li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--copper);
    font-size: 0.85rem;
    top: 0.15rem;
  }

  .committee-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .committee-grid li {
    background: var(--bg);
    padding: 1.25rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .committee-grid .role {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--copper);
  }
  .committee-grid .name {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 24, 'wdth' 100, 'wght' 500;
    font-size: 1.1rem;
    letter-spacing: -0.005em;
    color: var(--bone);
  }
  .committee-grid .email {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--bone-soft);
    margin-top: 0.2rem;
  }
  .committee-grid .email:hover { color: var(--copper); }

  .committee-grid li.placeholder .name {
    color: var(--bone-soft);
    font-style: italic;
    font-variation-settings: 'opsz' 24, 'wdth' 95, 'wght' 400;
  }
  .committee-grid li.placeholder .hint {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  .committee-grid--past .name {
    font-size: 1rem;
    color: var(--bone-soft);
  }
  .committee-grid--past .role {
    color: var(--bone-soft);
  }

  .contact {
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem 3rem;
  }
  .contact dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bone-soft);
    margin: 0 0 0.4rem;
  }
  .contact dd {
    margin: 0;
    line-height: 1.5;
  }
  .contact a {
    color: var(--copper);
    border-bottom: 1px solid color-mix(in srgb, var(--copper) 50%, transparent);
  }
  .contact a:hover { color: var(--copper-bright); }
</style>
