---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const committee = (await getCollection('committee')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="About"
  description="The Earth Sciences Postgraduate Group represents HDR students in the School of Geography, Earth and Atmospheric Sciences at the University of Melbourne."
>
  <p class="eyebrow">About</p>
  <h1>About ESPG</h1>

  <div class="prose">
    <p class="lede">
      The Earth Sciences Postgraduate Group represents masters and PhD students in the School of
      Geography, Earth and Atmospheric Sciences (SGEAS) at the University of Melbourne.
    </p>
    <p>
      We exist to build community across research groups, run social and academic events, and
      give postgraduates a voice in school-level decisions. Membership is free for any
      SGEAS-enrolled postgrad. We're affiliated with the UMSU Graduate Student Association.
    </p>
    <h2>What we do</h2>
    <ul>
      <li>An annual postgraduate-led conference for HDR students.</li>
      <li>Regular social events: pub nights, BBQs, weekend field trips.</li>
      <li>Skills sessions and PhD-life discussions across research areas.</li>
      <li>Representation to the school and faculty on student matters.</li>
    </ul>
  </div>

  <hr />

  <h2>Committee</h2>
  {
    committee.length === 0 ? (
      <p class="muted">Committee members will be listed here once content is migrated.</p>
    ) : (
      <ul class="committee-grid">
        {committee.map((m) => (
          <li class="committee-card">
            <h3>{m.data.name}</h3>
            <p class="role muted">{m.data.role}</p>
            {m.data.email && (
              <p>
                <a href={`mailto:${m.data.email}`}>{m.data.email}</a>
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .lede {
    font-size: 1.15rem;
  }
  .committee-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-4);
  }
  .committee-card {
    padding: var(--space-3);
    border: 1px solid var(--color-rule);
    border-radius: 2px;
  }
  .committee-card h3 {
    margin: 0 0 var(--space-1);
    font-size: 1.1rem;
  }
  .committee-card .role {
    margin: 0 0 var(--space-2);
    font-size: 0.9rem;
  }
</style>
