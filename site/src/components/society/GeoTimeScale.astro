---
/**
 * International Chronostratigraphic Chart — eras only, in ICS 2023 colours.
 *
 * Hierarchy: 4 eons (Phanerozoic, Proterozoic, Archean, Hadean), divided into
 *   3 + 3 + 4 + 0 = 10 eras. Hadean has no formally subdivided eras under ICS,
 *   so the chart ends at 4000 Ma (start of the Eoarchean).
 *
 * Layout: the chart is position-fixed (one viewport tall, left edge). An
 * internal indicator moves down the chart as a function of page scroll
 * progress, so scrollY = 0 lands on Cenozoic ("now") and scrollY = max lands
 * on Eoarchean (deepest era).
 */

interface Era {
  name: string;
  fromMa: number;
  toMa: number;
  color: string;
  /** Optional override for label vertical position, in % of chart height.
   *  Used to keep the thin Phanerozoic labels from colliding. */
  labelTop?: number;
  /** Major Earth-system event at the era's base (fromMa). */
  event?: string;
}

const eras: Era[] = [
  { name: 'Cenozoic',         fromMa:   66.0, toMa:    0.0, color: '#F2F91D', labelTop:  5.0, event: 'K–Pg impact' },
  { name: 'Mesozoic',         fromMa:  251.9, toMa:   66.0, color: '#67C5CA', labelTop:  9.0, event: 'End-Permian extinction' },
  { name: 'Paleozoic',        fromMa:  538.8, toMa:  251.9, color: '#99C08D', labelTop: 13.5, event: 'Cambrian explosion' },
  { name: 'Neoproterozoic',   fromMa: 1000.0, toMa:  538.8, color: '#FEB342' },
  { name: 'Mesoproterozoic',  fromMa: 1600.0, toMa: 1000.0, color: '#FDB462' },
  { name: 'Paleoproterozoic', fromMa: 2500.0, toMa: 1600.0, color: '#F74370', event: 'Great Oxidation Event' },
  { name: 'Neoarchean',       fromMa: 2800.0, toMa: 2500.0, color: '#F9837C' },
  { name: 'Mesoarchean',      fromMa: 3200.0, toMa: 2800.0, color: '#F767A0' },
  { name: 'Paleoarchean',     fromMa: 3600.0, toMa: 3200.0, color: '#DB4D7D' },
  { name: 'Eoarchean',        fromMa: 4000.0, toMa: 3600.0, color: '#DA037F' },
];

/**
 * Mid-era events rendered as separate copper ticks on the chart.
 * Kept sparse to avoid clutter.
 */
const midEraEvents: Array<{ ageMa: number; label: string }> = [
  { ageMa: 720, label: 'Snowball Earth' },
];

const TOTAL_MA = 4000.0;
const bands = eras.map((e) => {
  const topPct = (e.toMa / TOTAL_MA) * 100;
  const bottomPct = (e.fromMa / TOTAL_MA) * 100;
  const heightPct = bottomPct - topPct;
  return {
    ...e,
    topPct,
    bottomPct,
    heightPct,
    centrePct: topPct + heightPct / 2,
    placementPct: e.labelTop ?? topPct + heightPct / 2,
  };
});

const bandsJson = JSON.stringify(
  bands.map((b) => ({ name: b.name, topPct: b.topPct, bottomPct: b.bottomPct })),
);
---

<aside class="gts" aria-label="Geological time scale">
  <div class="gts-col">
    {
      bands.map((b) => (
        <div
          class="gts-band"
          data-era={b.name}
          style={`top: ${b.topPct}%; height: ${b.heightPct}%; background: ${b.color};`}
          title={`${b.name} — ${b.fromMa} to ${b.toMa} Ma`}
        />
      ))
    }
    <div class="gts-now" aria-hidden="true"></div>
    <div class="gts-indicator" data-indicator aria-hidden="true">
      <div class="gts-indicator-arrow"></div>
      <div class="gts-indicator-line"></div>
    </div>
  </div>

  <div class="gts-labels">
    <div class="gts-now-label">
      ● Now<span class="yr">2026 CE</span>
    </div>
    {
      bands.map((b) => (
        <div class="gts-label" data-era-label={b.name} style={`top: ${b.placementPct}%;`}>
          <span class="nm">{b.name}</span>
          <span class="age">
            {b.fromMa.toFixed(1).replace(/\.0$/, '')} Ma{b.event && (
              <span class="evt"> · {b.event}</span>
            )}
          </span>
        </div>
      ))
    }
    {
      midEraEvents.map((e) => {
        const topPct = (e.ageMa / TOTAL_MA) * 100;
        return (
          <div class="gts-midevent" style={`top: ${topPct}%;`}>
            <span class="mid-tick"></span>
            <span class="mid-label">{e.label} · {e.ageMa} Ma</span>
          </div>
        );
      })
    }
  </div>
</aside>

<style>
  .gts {
    position: fixed;
    left: 0;
    top: 8px; /* leave room for the climate stripes band */
    bottom: 0;
    width: var(--time-col);
    z-index: 10;
    pointer-events: none;
    padding: 2.5rem 0.75rem 1.5rem 1rem;
    display: flex;
    gap: 0.6rem;
    border-right: 1px solid var(--rule);
    background: linear-gradient(to right, rgba(0, 0, 0, 0.25), transparent);
  }

  .gts-col {
    position: relative;
    width: 22px;
    flex: 0 0 22px;
    border: 1px solid var(--rule-warm);
    background: var(--bg-cool);
    overflow: visible; /* allow indicator arrow to spill left */
  }
  .gts-col > .gts-band {
    position: absolute;
    left: 0;
    right: 0;
    overflow: hidden;
  }
  .gts-band::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: rgba(0, 0, 0, 0.4);
  }
  .gts-band:first-child::after { display: none; }

  /* "Now" pulsing dot at the very top of the column */
  .gts-now {
    position: absolute;
    left: -10px;
    top: -2px;
    width: 14px;
    height: 14px;
    background: var(--copper);
    border: 2px solid var(--bg);
    border-radius: 50%;
    z-index: 3;
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 8px rgba(208, 118, 54, 0.55); }
    50%      { box-shadow: 0 0 18px rgba(208, 118, 54, 0.95); }
  }

  /* Scroll indicator — copper arrow + hairline crossing into the labels area */
  .gts-indicator {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0;
    z-index: 4;
    will-change: transform, opacity;
    transition: transform 90ms linear, opacity 220ms ease;
    opacity: 0;
  }
  .gts-indicator[data-visible='true'] {
    opacity: 1;
  }
  .gts-indicator-arrow {
    position: absolute;
    left: -7px;
    top: -5px;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 5px 0 5px 8px;
    border-color: transparent transparent transparent var(--copper);
    filter: drop-shadow(0 0 4px rgba(208, 118, 54, 0.7));
  }
  .gts-indicator-line {
    position: absolute;
    left: 22px;
    width: calc(var(--time-col) - 2rem);
    height: 0;
    border-top: 1px dashed rgba(208, 118, 54, 0.5);
  }

  .gts-labels {
    position: relative;
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    line-height: 1.2;
    letter-spacing: 0.05em;
    color: var(--bone-soft);
  }
  .gts-label {
    position: absolute;
    left: 0;
    right: 0;
    padding-left: 0.4rem;
    transform: translateY(-50%);
    transition: color 220ms ease;
  }
  .gts-label .nm {
    display: block;
    color: var(--bone);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.6rem;
    font-weight: 500;
    transition: color 220ms ease;
  }
  .gts-label .age {
    display: block;
    color: var(--muted);
    font-size: 0.55rem;
    margin-top: 1px;
  }
  .gts-label .evt {
    color: var(--copper);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Mid-era events (e.g. Snowball Earth) — copper tick + small label */
  .gts-midevent {
    position: absolute;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    pointer-events: none;
  }
  .gts-midevent .mid-tick {
    display: inline-block;
    width: 8px;
    height: 1px;
    background: var(--copper);
    flex: 0 0 8px;
    margin-left: -0.4rem;
  }
  .gts-midevent .mid-label {
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-style: italic;
    letter-spacing: 0.04em;
    color: var(--copper);
    white-space: nowrap;
  }
  .gts-label::before {
    content: '';
    position: absolute;
    left: -0.6rem;
    top: 50%;
    width: 0.4rem;
    height: 1px;
    background: var(--rule);
    transition: background 220ms ease, width 220ms ease;
  }
  .gts-label[data-active='true'] .nm { color: var(--copper); }
  .gts-label[data-active='true']::before {
    background: var(--copper);
    width: 0.6rem;
  }

  .gts-now-label {
    position: absolute;
    left: 0;
    right: 0;
    top: -2rem;
    padding-left: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.15;
    color: var(--copper);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .gts-now-label .yr {
    display: inline-block;
    color: var(--bone-soft);
    text-transform: none;
    letter-spacing: 0.04em;
    margin-left: 0.45rem;
    font-weight: 400;
  }

  @media (max-width: 860px) {
    .gts { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gts-now { animation: none; }
    .gts-indicator { transition: none; }
  }
</style>

<script is:inline define:vars={{ bandsJson }}>
  // Map page scroll progress (0..1) to a vertical position inside the time
  // scale, then highlight the era at that position.
  (function () {
    const bands = JSON.parse(bandsJson);
    const indicator = document.querySelector('[data-indicator]');
    const col = document.querySelector('.gts-col');
    const labelEls = Array.from(document.querySelectorAll('[data-era-label]'));
    if (!indicator || !col) return;

    let pending = 0;
    let lastEra = '';

    function eraAt(pct) {
      for (const b of bands) {
        if (pct >= b.topPct && pct < b.bottomPct) return b.name;
      }
      return bands[bands.length - 1].name;
    }

    function update() {
      pending = 0;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      const progress = maxScroll > 0 ? Math.min(1, Math.max(0, window.scrollY / maxScroll)) : 0;
      const chartH = col.clientHeight;
      const y = progress * chartH;
      indicator.style.transform = `translateY(${y}px)`;
      // Hide the indicator while at the very top so the "● Now" dot speaks alone.
      indicator.dataset.visible = progress > 0.005 ? 'true' : 'false';
      const pct = progress * 100;
      const era = eraAt(pct);
      if (era !== lastEra) {
        lastEra = era;
        for (const el of labelEls) {
          el.dataset.active = el.dataset.eraLabel === era ? 'true' : 'false';
        }
      }
    }

    function schedule() {
      if (pending) return;
      pending = requestAnimationFrame(update);
    }

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    update();
  })();
</script>
