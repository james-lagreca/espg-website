---
/**
 * Vertical atmospheric profile, anchored to the right edge of the page,
 * mirroring the geological time scale on the left. Surface at the bottom,
 * space at the top. Chart range: 0–100 km (Kármán line at the top).
 *
 * Layers (US Standard Atmosphere 1976):
 *   Troposphere   0–12 km
 *   Stratosphere  12–50 km
 *   Mesosphere    50–85 km
 *   Thermosphere  85+ km (visually extends off the top of the chart)
 */

interface Layer {
  name: string;
  fromKm: number;
  toKm: number;
  labelTopPct: number; // explicit label position from top of column
}

const layers: Layer[] = [
  { name: 'Troposphere',  fromKm:  0, toKm:  12, labelTopPct: 95 },
  { name: 'Stratosphere', fromKm: 12, toKm:  50, labelTopPct: 70 },
  { name: 'Mesosphere',   fromKm: 50, toKm:  85, labelTopPct: 32 },
  { name: 'Thermosphere', fromKm: 85, toKm: 100, labelTopPct:  7 },
];

const MAX_KM = 100;
function pctFromTop(km: number): number {
  return ((MAX_KM - km) / MAX_KM) * 100;
}

const boundaries = [
  { name: 'Tropopause',  km: 12, label: 'Tropopause · 12 km' },
  { name: 'Stratopause', km: 50, label: 'Stratopause · 50 km' },
  { name: 'Mesopause',   km: 85, label: 'Mesopause · 85 km' },
];

const markers = [
  { km: 100, label: 'Kármán · 100 km',  prominent: true  },
  { km:  25, label: 'Ozone · 25 km',    prominent: false },
  { km:  11, label: 'Aircraft · 11 km', prominent: false },
];
---

<aside class="atm" aria-label="Atmospheric profile">
  <div class="atm-labels">
    {
      layers.map((l) => (
        <div class="atm-label" style={`top: ${l.labelTopPct}%;`}>
          <span class="nm">{l.name}</span>
          <span class="alt">{l.fromKm}{l.toKm < MAX_KM ? `–${l.toKm}` : '+'} km</span>
        </div>
      ))
    }
    <div class="atm-space-label">
      ↑ Space<span class="sub">extends to ∼10,000 km</span>
    </div>
    <div class="atm-surface-label">
      Surface<span class="sub">0 km</span>
    </div>
  </div>

  <div class="atm-col">
    <!-- vertical gradient: sky-blue at bottom → deep navy at top -->
    <div class="atm-gradient"></div>

    <!-- subtle ozone band at ~20–30 km within the stratosphere -->
    <div class="atm-ozone" style={`top: ${pctFromTop(30)}%; height: ${pctFromTop(20) - pctFromTop(30)}%;`}></div>

    <!-- layer boundaries -->
    {
      boundaries.map((b) => (
        <div class="atm-boundary" style={`top: ${pctFromTop(b.km)}%;`} title={b.label} />
      ))
    }

    <!-- reference markers (small triangles + tiny labels inside the column) -->
    {
      markers.map((m) => (
        <div
          class={`atm-marker ${m.prominent ? 'atm-marker--prominent' : ''}`}
          style={`top: ${pctFromTop(m.km)}%;`}
        >
          <span class="atm-marker-dot"></span>
          <span class="atm-marker-text">{m.label}</span>
        </div>
      ))
    }
  </div>
</aside>

<style>
  .atm {
    position: fixed;
    right: 0;
    top: 8px;
    bottom: 0;
    width: var(--atm-col);
    z-index: 10;
    pointer-events: none;
    padding: 2.5rem 1rem 1.5rem 0.75rem;
    display: flex;
    gap: 0.6rem;
    border-left: 1px solid var(--rule);
    background: linear-gradient(to left, rgba(0, 0, 0, 0.25), transparent);
  }

  /* Labels column on the LEFT (mirror of time scale layout) */
  .atm-labels {
    position: relative;
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    line-height: 1.2;
    letter-spacing: 0.05em;
    color: var(--bone-soft);
  }
  .atm-label {
    position: absolute;
    left: 0;
    right: 0;
    padding-right: 0.4rem;
    transform: translateY(-50%);
    text-align: right;
  }
  .atm-label .nm {
    display: block;
    color: var(--bone);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.6rem;
    font-weight: 500;
  }
  .atm-label .alt {
    display: block;
    color: var(--muted);
    font-size: 0.55rem;
    margin-top: 1px;
  }
  .atm-label::after {
    /* mirror of the time-scale leader line, but to the right */
    content: '';
    position: absolute;
    right: -0.6rem;
    top: 50%;
    width: 0.4rem;
    height: 1px;
    background: var(--rule);
  }

  .atm-space-label {
    position: absolute;
    top: -2rem;
    right: 0;
    padding-right: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.15;
    color: var(--bone-soft);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    text-align: right;
  }
  .atm-space-label .sub {
    display: block;
    color: var(--muted);
    text-transform: none;
    letter-spacing: 0.04em;
    font-weight: 400;
    margin-top: 1px;
    font-size: 0.55rem;
  }
  .atm-surface-label {
    position: absolute;
    bottom: -1.5rem;
    right: 0;
    padding-right: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.15;
    color: var(--bone-soft);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    text-align: right;
  }
  .atm-surface-label .sub {
    display: block;
    color: var(--muted);
    text-transform: none;
    letter-spacing: 0.04em;
    font-weight: 400;
    margin-top: 1px;
    font-size: 0.55rem;
  }

  /* Column (right side — mirror of time-scale's chart column) */
  .atm-col {
    position: relative;
    width: 22px;
    flex: 0 0 22px;
    border: 1px solid var(--rule-warm);
    overflow: visible;
    background: var(--bg-cool);
  }
  .atm-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      #6bb1e8 0%,    /* sky-blue surface */
      #4a8fc9 12%,   /* tropopause */
      #2e6fa8 30%,   /* lower stratosphere */
      #1f4d80 50%,   /* stratopause */
      #15315a 70%,   /* mesopause */
      #0a1b3a 90%,   /* thermosphere */
      #050510 100%   /* edge of space */
    );
  }
  /* Ozone band — faint warm tint inside stratosphere */
  .atm-ozone {
    position: absolute;
    left: 0;
    right: 0;
    background: linear-gradient(to top, transparent, rgba(255, 170, 60, 0.25), transparent);
    pointer-events: none;
  }
  /* Hard hairline at each layer boundary */
  .atm-boundary {
    position: absolute;
    left: -2px;
    right: -2px;
    height: 1px;
    background: rgba(0, 0, 0, 0.4);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  /* Reference markers — small dot + label spilling right (off the column) */
  .atm-marker {
    position: absolute;
    left: 22px;
    right: -7rem;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    pointer-events: none;
  }
  .atm-marker-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--bone-soft);
    flex: 0 0 5px;
  }
  .atm-marker-text {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .atm-marker--prominent .atm-marker-dot {
    background: var(--copper);
    box-shadow: 0 0 6px rgba(208, 118, 54, 0.6);
  }
  .atm-marker--prominent .atm-marker-text {
    color: var(--copper);
  }
  /* Markers stick out leftward into the labels column area.
     The "left: 22px" pushes them off the column to the left.   */
  .atm-marker {
    left: auto;
    right: 22px;
    flex-direction: row-reverse;
  }

  @media (max-width: 980px) {
    .atm { display: none; }
  }
</style>
