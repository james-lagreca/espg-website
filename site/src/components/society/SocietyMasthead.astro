---
import { url } from '../../lib/url';

interface FeaturedEvent {
  id: string;
  date: Date;
  title: string;
  location: string;
}

interface Props {
  featured?: FeaturedEvent[];
}
const { featured = [] } = Astro.props;

const dayFmt = new Intl.DateTimeFormat('en-AU', { day: '2-digit', month: 'short' });
const wdFmt = new Intl.DateTimeFormat('en-AU', { weekday: 'short' });
---

<section class="mast">
  <!-- Ambient weather decoration: wispy clouds + isobar-style curves + a tiny
       synoptic-chart H drift behind the masthead content. Very low opacity. -->
  <svg class="mast-weather" aria-hidden="true" viewBox="0 0 600 240" preserveAspectRatio="none">
    <defs>
      <linearGradient id="cloudFade" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0%" stop-color="#e6e1d6" stop-opacity="0" />
        <stop offset="50%" stop-color="#e6e1d6" stop-opacity="0.18" />
        <stop offset="100%" stop-color="#e6e1d6" stop-opacity="0" />
      </linearGradient>
    </defs>
    <!-- Three drifting wispy clouds -->
    <path d="M40,60 Q30,40 60,48 Q80,30 110,42 Q140,38 150,58 Q170,55 165,72 Q120,70 40,68 Z"
          fill="url(#cloudFade)" />
    <path d="M380,90 Q370,72 400,80 Q430,68 460,82 Q490,80 500,98 Q470,100 380,98 Z"
          fill="url(#cloudFade)" opacity="0.7" />
    <path d="M180,180 Q175,168 200,172 Q220,162 245,174 Q260,180 250,190 Q220,192 180,188 Z"
          fill="url(#cloudFade)" opacity="0.5" />
    <!-- Isobar-like curves -->
    <path d="M0,40 Q200,20 400,42 T 600,40" fill="none" stroke="#d07636" stroke-width="0.6" stroke-opacity="0.18" />
    <path d="M0,200 Q200,180 400,202 T 600,200" fill="none" stroke="#d07636" stroke-width="0.6" stroke-opacity="0.14" />
  </svg>

  <div class="mast-top">
    <div class="specimen reveal" aria-hidden="true">
      <div class="specimen-disc">
        <img src={url('/espg-logo.svg')} alt="" />
      </div>
      <span class="specimen-label">ESPG · Earth Sciences</span>
    </div>

    <div class="mast-text reveal">
      <p class="sect-tag">Earth Sciences Postgraduate Group · University of Melbourne</p>
      <h1>A postgraduate community in <em>deep time</em>.</h1>
    </div>

    <div class="mast-cta reveal">
      <a href={url('/membership')} class="cta">
        Join the society <span class="arrow">→</span>
      </a>
      <span class="cta-aside">Free · 1-minute sign-up</span>
    </div>
  </div>

  <p class="mast-lede reveal">
    Built by postgrads, for postgrads — across geology, geophysics, atmospheric and environmental
    sciences. <strong>Academic support, social events</strong>, and the people you'll be at
    conferences with for the next decade.
  </p>

  {
    featured.length > 0 && (
      <>
        <p class="nextup-tag reveal">Next up — three closest dates</p>
        <div class="nextup reveal">
          {featured.map((e) => {
            const [day, mo] = dayFmt.format(e.date).split(' ');
            const wd = wdFmt.format(e.date);
            return (
              <a href={url(`/events/${e.id}`)}>
                <div class="day-row">
                  <span>{day} {mo}</span>
                  <span class="yr">'{e.date.getFullYear().toString().slice(2)} · {wd}</span>
                </div>
                <h3 class="nu-title">{e.title}</h3>
                <div class="nu-loc">{e.location}</div>
              </a>
            );
          })}
        </div>
      </>
    )
  }
</section>

<style>
  .mast {
    position: relative;
    padding: clamp(1rem, 2vw, 2rem) 0 clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--rule);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .mast-weather {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.5;
    z-index: 0;
  }
  .mast-top, .mast-lede, .nextup-tag, .nextup { position: relative; z-index: 1; }
  .mast h1 {
    font-size: clamp(2.4rem, 5.6vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 16ch;
    margin: 0 0 0.4rem;
  }
  .mast h1 em {
    font-style: italic;
    font-variation-settings: 'opsz' 96, 'wdth' 95, 'wght' 400;
    color: var(--copper);
  }
  .mast-top {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) minmax(0, auto);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
  }
  .specimen {
    position: relative;
    width: clamp(74px, 9vw, 104px);
    aspect-ratio: 1;
    flex: 0 0 auto;
  }
  .specimen::before {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1px solid var(--rule-warm);
  }
  .specimen-disc {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f7f2e6 0%, #ebe4d2 70%, #d6cdb6 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.06),
      inset 0 6px 18px rgba(0, 0, 0, 0.08),
      0 8px 32px rgba(0, 0, 0, 0.35);
  }
  .specimen-disc img { width: 78%; height: 78%; object-fit: contain; }
  .specimen-label {
    position: absolute;
    left: 50%;
    bottom: -1.8rem;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mast-text { min-width: 0; }
  .mast-cta {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }
  @media (max-width: 720px) {
    .mast-top { grid-template-columns: minmax(0, auto) minmax(0, 1fr); }
    .mast-cta { grid-column: 1 / -1; align-items: stretch; flex-direction: row; flex-wrap: wrap; }
  }

  .mast-lede {
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    font-size: clamp(1.05rem, 1.45vw, 1.25rem);
    line-height: 1.45;
    max-width: 58ch;
    color: var(--bone);
  }
  .mast-lede strong { color: var(--copper); font-weight: 500; }

  .nextup-tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--copper);
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nextup-tag::before {
    content: '';
    width: 1rem;
    height: 1px;
    background: var(--copper);
  }

  .nextup {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .nextup a {
    background: var(--bg);
    padding: 1.2rem 1.2rem 1.1rem;
    display: block;
    text-decoration: none;
    color: var(--bone);
    transition: background 180ms ease;
  }
  .nextup a:hover { background: var(--bg-card); color: var(--bone); }
  .nextup .day-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--copper);
    letter-spacing: 0.06em;
    margin-bottom: 0.3rem;
  }
  .nextup .day-row .yr { color: var(--muted); }
  .nextup .nu-title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 22, 'wdth' 100, 'wght' 500;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0 0 0.25rem;
  }
  .nextup .nu-loc {
    font-size: 0.83rem;
    color: var(--bone-soft);
  }
</style>
